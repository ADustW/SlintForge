import { ForgeFlowCanvas, ForgeFlowNode, ForgeFlowLayoutControls } from "@slintforge";

export component FlowLayoutUsage inherits Window {
    width: 1000px; height: 700px;
    // 两端宿主绑定 ForgeFlowServices 后，面板可直接使用同一公共布局命令。
    graph := ForgeFlowCanvas {
        demo: 2;
        for node in graph.state.nodes : ForgeFlowNode {
            node: node; zoom: graph.viewport.zoom; action(a) => { graph.act(a); }
        }
    }
    ForgeFlowLayoutControls {
        x: parent.width - self.width - 12px; y: 12px; width: 288px; height: 224px;
        action(a) => { graph.act(a); if graph.state.ok { graph.fit(); } }
    }
}
