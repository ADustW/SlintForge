import { TabWidget } from "std-widgets.slint";
export component Example inherits Window {
    width: 520px; height: 320px;
    TabWidget { Tab { title: "A"; Text { text: "Page A"; } } Tab { title: "B"; Text { text: "Page B"; } } }
}