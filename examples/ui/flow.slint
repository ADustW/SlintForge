import { Button, Palette } from "std-widgets.slint";
import { ForgeFlowShowcase } from "flow-showcase.slint";
import { ForgeFlowAction, ForgeFlowState } from "@slintforge";
export { ForgeFlowPointData, ForgeFlowPortData, ForgeFlowNodeData, ForgeFlowEdgeData, ForgeFlowViewport, ForgeFlowRect, ForgeFlowAction, ForgeFlowState, ForgeFlowServices } from "@slintforge";
export { ForgeFlowTransformWindow } from "flow-transform.slint";
export component ForgeFlowWindow inherits Window {
    title: "ForgeFlow · 节点与连线"; preferred-width: 1100px; preferred-height: 760px; min-width: 520px; min-height: 420px;
    in-out property<bool> chinese: true;
    in-out property<bool> dark: false;
    in-out property<int> variant: 1;
    in-out property<string> blocked-target;
    in-out property<string> blocked-operation;
    in-out property<bool> read-only <=> showcase.read-only;
    in-out property<bool> animations-enabled <=> showcase.animations-enabled;
    // 仅供性能诊断隔离绘制层，正常示例保持全部开启。
    in-out property<bool> diagnostic-background <=> showcase.diagnostic-background;
    in-out property<bool> diagnostic-minimap <=> showcase.diagnostic-minimap;
    in-out property<string> file-path <=> showcase.file-path;
    in-out property<string> image-path <=> showcase.image-path;
    out property<int> save-count;
    out property<int> export-count;
    out property<ForgeFlowState> state: showcase.state;
    out property<int> business-count: showcase.business-count;
    out property<string> flow-error: showcase.error;
    out property<string> connection-path: showcase.connection-path;
    out property<string> last-interaction;
    out property<string> last-interaction-id;
    out property<int> edit-count;
    callback interaction(string, ForgeFlowAction);
    callback edit(ForgeFlowAction); edit(a) => { showcase.edit(a); }
    callback fit(); fit => { showcase.fit(); }
    callback zoom(float); zoom(z) => { showcase.zoom(z); }
    callback set-view(float,float,float); set-view(x,y,z) => { showcase.set-view(x,y,z); }
    callback document-json() -> string; document-json => { return showcase.document-json(); }
    callback save-document(); save-document => { showcase.save-document(); }
    callback dispose(); dispose => { showcase.dispose(); }
    callback reopen(); reopen => { showcase.reopen(); }
    callback focus-canvas(); focus-canvas => { showcase.focus-canvas(); }
    callback export-image(bool); export-image(selected) => { showcase.export-image(selected); }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    Rectangle {
        HorizontalLayout {
            x: 0px; y: 0px; width: parent.width;
            padding: 8px; spacing: 5px; height: 48px;
            for label[i] in (root.chinese ? ["基础编辑", "自定义卡片", "流程图", "拓扑图", "思维导图"] : ["Editor", "Custom cards", "Flowchart", "Topology", "Mind map"]) : Button {
                text: label; primary: root.variant == i; clicked => { root.variant = i; showcase.edit({op: "demo", number: i}); if i >= 2 { showcase.fit(); } }
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: root.chinese ? "EN" : "中文"; clicked => { root.chinese = !root.chinese; } }
            Button { text: root.dark ? (root.chinese ? "浅" : "Light") : (root.chinese ? "深" : "Dark"); clicked => { root.dark = !root.dark; } }
        }
        showcase := ForgeFlowShowcase {
            y: 48px; width: parent.width; height: parent.height - 48px; variant: root.variant; chinese: root.chinese; blocked-target: root.blocked-target; blocked-operation: root.blocked-operation;
            interaction(name,a) => { root.last-interaction = name; root.last-interaction-id = a.id; root.interaction(name,a); }
            edited(a,state) => { root.edit-count += 1; }
            save-finished(path,error) => { if error == "" { root.save-count += 1; } }
            image-exported(path,error) => { if error == "" { root.export-count += 1; } }
        }
    }
}
