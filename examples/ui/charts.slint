import { Palette } from "std-widgets.slint";
import { ForgePlot, ForgePlotKind } from "@slintforge";
export { ForgePlotServices, ForgePlotScene, ForgePlotAxis, ForgePlotRange, ForgePlotRect, ForgePlotHit, ForgePlotSelection, ForgePlotExportResult } from "@slintforge";
export component ChartsWindow inherits Window {
    title: "SlintForge · ForgePlot"; width: 720px; height: 480px;
    background: Palette.background;
    in-out property<int> kind: 0;
    property<ForgePlotKind> plot-kind: root.kind == 0 ? bars : root.kind == 2 ? pie : root.kind == 3 ? polar-area : root.kind == 4 ? bubble : root.kind == 6 ? radar : graph;
    property<bool> slices: root.kind == 2 || root.kind == 3;
    out property<int> status: plot.scene.status;
    out property<int> mark-count: plot.scene.rendered-points;
    plot := ForgePlot {
        x: 16px; y: 16px; width: parent.width - 32px; height: parent.height - 32px;
        legend-placement: outside;
        panels: [{id: 0,width: 1,height: 1,categories: root.slices ? ["A","B"] : ["A","B","C"]}];
        series: root.slices ? [{id: 1,kind: root.plot-kind,name: "Distribution",points: [{y: 1},{y: 3}]}] : [
            {id: 1,kind: root.plot-kind,name: "A",color: Palette.accent-background,line-style: root.kind == 5 ? none : line,scatter-style: disc,point-size: 12,points: [{x: 0,y: 20},{x: 1,y: 60},{x: 2,y: 40}]},
            {id: 2,kind: root.plot-kind,name: "B",color: #00a78e,line-style: root.kind == 5 ? none : line,scatter-style: disc,point-size: 18,points: [{x: 0,y: 30},{x: 1,y: 10},{x: 2,y: 50}]}
        ];
    }
}
