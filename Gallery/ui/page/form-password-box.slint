import { Button, CheckBox, LineEdit, Palette } from "std-widgets.slint";
import { ForgeTypography } from "@slintforge";
import { GalleryComponentPage, GalleryExample, GalleryPreview, GalleryOptions } from "../component/component-page.slint";

// Slint 原生示例：PasswordBox。
export component GalleryFormPasswordBoxPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    private property<bool> disabled1: false;
    private property<string> new-password;
    private property<string> confirm-password;
    private property<bool> reveal: false;
    private property<int> length: root.new-password.character-count;
    private property<int> strength: root.length == 0 ? 0 : root.length < 8 ? 1 : root.length < 12 ? 2 : 3;
    private property<bool> matched: root.confirm-password != "" && root.confirm-password == root.new-password;
    private property<string> change-status: @tr("尚未修改");
    callback prepare-preview(bool);
    prepare-preview(open) => {  }

    GalleryComponentPage {
        width: parent.width; height: parent.height;
        category: @tr("表单");
        title: "PasswordBox";
        subtitle: @tr("以圆点遮盖输入内容的密码框，由原生 LineEdit 设置 input-type: password 实现；可切换为明文以便核对。");
        native: true;
        showcase-route: "form-password-box";
        qa-anchors: [states.y, scenario.y];
        api: [
            { name: "input-type", kind: @tr("属性"), type: "InputType", description: @tr("password 遮盖输入，text 显示明文。") },
            { name: "text", kind: @tr("属性"), type: "string", description: @tr("输入的密码，可双向绑定。") },
            { name: "placeholder-text", kind: @tr("属性"), type: "string", description: @tr("文本为空时显示的提示。") },
            { name: "enabled", kind: @tr("属性"), type: "bool", description: @tr("禁用输入。") },
            { name: "edited(string) / accepted(string)", kind: @tr("回调"), type: "", description: @tr("修改文本或按 Enter 时触发。") },
        ];

        GalleryExample {
            title: @tr("基本用法");
            description: @tr("取消勾选 password 即可显示明文。");
            output: root.status;
            GalleryPreview {
                LineEdit {
                    width: 260px * ForgeTypography.scale;
                    input-type: root.flag ? InputType.password : InputType.text;
                    text <=> root.draft; placeholder-text: @tr("输入密码"); enabled: !root.disabled1;
                    edited(value) => { root.status = @tr("edited · {} 个字符", value.character-count); }
                    accepted(value) => { root.status = @tr("accepted · {} 个字符", value.character-count); }
                }
            }
            GalleryOptions {
                CheckBox { text: "input-type: password"; checked <=> root.flag; }
                CheckBox { text: @tr("禁用"); checked <=> root.disabled1; }
            }
        }

        states := GalleryExample {
            title: @tr("状态对照");
            description: @tr("同一段文字分别以遮盖、明文和禁用状态显示。");
            GalleryPreview {
                GridLayout {
                    spacing-horizontal: 16px; spacing-vertical: 10px;
                    Row {
                        Text { text: "input-type: password"; color: Palette.foreground.transparentize(0.45); vertical-alignment: center; }
                        LineEdit { width: 220px * ForgeTypography.scale; input-type: password; text: "SlintForge2026"; }
                    }
                    Row {
                        Text { text: "input-type: text"; color: Palette.foreground.transparentize(0.45); vertical-alignment: center; }
                        LineEdit { width: 220px * ForgeTypography.scale; input-type: text; text: "SlintForge2026"; }
                    }
                    Row {
                        Text { text: "enabled: false"; color: Palette.foreground.transparentize(0.45); vertical-alignment: center; }
                        LineEdit { width: 220px * ForgeTypography.scale; input-type: password; text: "SlintForge2026"; enabled: false; }
                    }
                }
            }
        }

        scenario := GalleryExample {
            title: @tr("修改密码");
            description: @tr("根据长度提示强度，两次输入一致且不少于 8 位时才能提交。");
            output: root.change-status;
            GalleryPreview {
                Rectangle {
                    width: 420px * ForgeTypography.scale;
                    height: form.preferred-height;
                    border-radius: 8px; border-width: 1px; border-color: Palette.border;
                    background: Palette.background;
                    form := VerticalLayout {
                        padding: 20px; spacing: 12px;
                        GridLayout {
                            spacing-horizontal: 16px; spacing-vertical: 10px;
                            Row {
                                Text { text: @tr("新密码"); color: Palette.foreground; vertical-alignment: center; }
                                LineEdit { input-type: root.reveal ? InputType.text : InputType.password; text <=> root.new-password; placeholder-text: @tr("至少 8 位"); }
                            }
                            Row {
                                Rectangle { }
                                HorizontalLayout {
                                    spacing: 4px;
                                    for level in 3 : Rectangle {
                                        height: 4px; border-radius: 2px;
                                        background: level < root.strength
                                            ? (root.strength == 1 ? #c42b1c : root.strength == 2 ? #f7a800 : #0f7b0f)
                                            : Palette.border;
                                    }
                                    Text {
                                        width: 48px * ForgeTypography.scale; horizontal-alignment: right;
                                        text: root.strength == 0 ? "" : root.strength == 1 ? @tr("弱") : root.strength == 2 ? @tr("中") : @tr("强");
                                        color: Palette.foreground.transparentize(0.45); font-size: 12px * ForgeTypography.scale;
                                    }
                                }
                            }
                            Row {
                                Text { text: @tr("确认密码"); color: Palette.foreground; vertical-alignment: center; }
                                LineEdit { input-type: root.reveal ? InputType.text : InputType.password; text <=> root.confirm-password; placeholder-text: @tr("再次输入"); }
                            }
                            Row {
                                Rectangle { }
                                Text {
                                    text: root.confirm-password == "" ? "" : root.matched ? @tr("两次输入一致") : @tr("两次输入不一致");
                                    color: root.matched ? #0f7b0f : #c42b1c; font-size: 12px * ForgeTypography.scale;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            CheckBox { text: @tr("显示密码"); checked <=> root.reveal; }
                            Rectangle { }
                            Button {
                                text: @tr("修改");
                                primary: true;
                                enabled: root.matched && root.length >= 8;
                                clicked => { root.change-status = @tr("密码已修改（{} 位）", root.length); root.new-password = ""; root.confirm-password = ""; }
                            }
                        }
                    }
                }
            }
        }
    }
}
