import { CheckBox, Palette, SpinBox } from "std-widgets.slint";
import { ForgeRatingControl, ForgeTypography } from "@slintforge";
import { GalleryComponentPage, GalleryExample, GalleryPreview, GalleryOptions } from "../component/component-page.slint";

// 共享组件演示：RatingControl。
export component GalleryFeedbackRatingPage inherits Rectangle {
    in-out property<int> count: 3;
    in-out property<bool> flag: false;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    private property<int> maximum: 5;
    private property<bool> disabled: false;
    private property<int> quality: 4;
    private property<int> delivery: 3;
    private property<int> service: 5;
    callback prepare-preview(bool);
    prepare-preview(open) => {  }

    GalleryComponentPage {
        width: parent.width; height: parent.height;
        category: @tr("反馈");
        title: "RatingControl";
        subtitle: @tr("以星级表示评分。点击星星评分，聚焦后可用方向键调整。");
        showcase-route: "feedback-rating";
        qa-anchors: [states.y, scenario.y];
        api: [
            { name: "value", kind: @tr("属性"), type: "int", description: @tr("当前评分，限制在 0 到 maximum 之间。") },
            { name: "maximum", kind: @tr("属性"), type: "int", description: @tr("星星数量，默认 5。") },
            { name: "read-only", kind: @tr("属性"), type: "bool", description: @tr("只显示评分，不接受修改。") },
            { name: "enabled", kind: @tr("属性"), type: "bool", description: @tr("禁用后变暗且不可操作。") },
            { name: "value-changed(int)", kind: @tr("回调"), type: "", description: @tr("用户修改评分后触发；宿主赋值不会触发。") },
            { name: "set-value(int)", kind: @tr("函数"), type: "", description: @tr("按范围约束设置评分。") },
        ];

        GalleryExample {
            title: @tr("基本用法");
            description: @tr("调整星星数量，或切换只读与禁用状态。");
            output: @tr("value-changed · 评分 {} / {}", rating.value, root.maximum);
            GalleryPreview {
                rating := ForgeRatingControl {
                    value: root.count; maximum: root.maximum; read-only: root.flag; enabled: !root.disabled;
                    value-changed(value) => { root.count = value; }
                }
            }
            GalleryOptions {
                Text { text: "maximum"; color: Palette.foreground.transparentize(0.45); font-size: 12px * ForgeTypography.scale; }
                SpinBox { minimum: 3; maximum: 10; value <=> root.maximum; }
                CheckBox { text: "read-only"; checked <=> root.flag; }
                CheckBox { text: @tr("禁用"); checked <=> root.disabled; }
            }
        }

        states := GalleryExample {
            title: @tr("状态对照");
            description: @tr("未评分、部分评分与只读满分。");
            GalleryPreview {
                // 五颗星较宽，三格并排在窄窗口中放不下，改用“标签 + 控件”列表。
                GridLayout {
                    spacing-horizontal: 16px; spacing-vertical: 10px;
                    Row {
                        Text { text: "value: 0"; color: Palette.foreground.transparentize(0.45); vertical-alignment: center; }
                        ForgeRatingControl { value: 0; }
                    }
                    Row {
                        Text { text: "value: 3"; color: Palette.foreground.transparentize(0.45); vertical-alignment: center; }
                        ForgeRatingControl { value: 3; }
                    }
                    Row {
                        Text { text: "read-only: true"; color: Palette.foreground.transparentize(0.45); vertical-alignment: center; }
                        ForgeRatingControl { value: 5; read-only: true; }
                    }
                }
            }
        }

        scenario := GalleryExample {
            title: @tr("订单评价");
            description: @tr("多个维度分别评分，汇总显示平均分。");
            output: @tr("综合评分 {}", Math.round((root.quality + root.delivery + root.service) * 10 / 3) / 10);
            GalleryPreview {
                Rectangle {
                    width: 360px * ForgeTypography.scale;
                    height: review.preferred-height;
                    border-radius: 8px; border-width: 1px; border-color: Palette.border;
                    background: Palette.background;
                    review := VerticalLayout {
                        padding: 20px; spacing: 12px;
                        Text { text: @tr("为本次订单评分"); color: Palette.foreground; font-size: 15px * ForgeTypography.scale; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: @tr("商品质量"); color: Palette.foreground; vertical-alignment: center; }
                            ForgeRatingControl { value: root.quality; value-changed(value) => { root.quality = value; } }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: @tr("物流速度"); color: Palette.foreground; vertical-alignment: center; }
                            ForgeRatingControl { value: root.delivery; value-changed(value) => { root.delivery = value; } }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: @tr("服务态度"); color: Palette.foreground; vertical-alignment: center; }
                            ForgeRatingControl { value: root.service; value-changed(value) => { root.service = value; } }
                        }
                    }
                }
            }
        }
    }
}
