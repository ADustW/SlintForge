import { ForgeTimePicker } from "@slintforge";
import { ForgeTypography } from "@slintforge";
import { GalleryPageFrame } from "../component/page-frame.slint";
import { GalleryPickerExample } from "../component/picker-example.slint";

export component GalleryFormTimePickerPage inherits Rectangle {
    in property<string> language: "zh";
    in-out property<bool> use-24-hour-format: false;
    in-out property<bool> clock-mode: true;
    callback prepare-preview(bool);
    callback configure-preview(bool, bool);
    configure-preview(use-24-hour, clock) => { root.use-24-hour-format = use-24-hour; root.clock-mode = clock; }
    prepare-preview(open) => { if open { first.open(); } else { first.close(); second.close(); third.close(); } }
    GalleryPageFrame {
        width: root.width; height: root.height;
        title: @tr("时间选择器"); subtitle: @tr("分栏选择时间，支持区域语言、12/24 小时制和分钟步长。");
        sample1 := GalleryPickerExample { label: @tr("12 小时制"); first := ForgeTimePicker { x: 0px; y: 0px; language: root.language; dark: sample1.dark; enabled: !sample1.disabled; use-24-hour-format: root.use-24-hour-format; clock-mode: root.clock-mode; } }
        sample2 := GalleryPickerExample { label: @tr("英文区域"); second := ForgeTimePicker { x: 0px; y: 0px; language: "en"; dark: sample2.dark; enabled: !sample2.disabled; } }
        sample3 := GalleryPickerExample { label: @tr("24 小时制，5 分钟步长"); third := ForgeTimePicker { x: 0px; y: 0px; language: root.language; dark: sample3.dark; enabled: !sample3.disabled; use-24-hour-format: true; minute-increment: 5; } }
    }
}
