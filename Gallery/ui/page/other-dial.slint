import { Button, CheckBox, Palette, Slider, SpinBox } from "std-widgets.slint";
import { ForgeDial, ForgeTypography } from "@slintforge";
import { GalleryComponentPage, GalleryExample, GalleryPreview, GalleryOptions, GalleryVariant } from "../component/component-page.slint";

// 共享组件演示：Dial。
export component GalleryOtherDialPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    private property<int> step: 1;
    private property<bool> disabled: false;
    private property<float> target: 24;
    private property<float> room: 27;
    callback prepare-preview(bool);
    prepare-preview(open) => {  }

    GalleryComponentPage {
        width: parent.width; height: parent.height;
        category: @tr("其他");
        title: "Dial";
        subtitle: @tr("圆形旋钮，在范围内调整一个数值。上下拖动、滚轮或方向键均可调节，适合音量、温度等连续参数。");
        api: [
            { name: "value", kind: @tr("属性"), type: "float", description: @tr("当前值，自动限制在 minimum 与 maximum 之间。") },
            { name: "minimum / maximum", kind: @tr("属性"), type: "float", description: @tr("取值范围，默认 0 到 100。") },
            { name: "step", kind: @tr("属性"), type: "float", description: @tr("滚轮和方向键每次调整的步长，默认 1。") },
            { name: "suffix", kind: @tr("属性"), type: "string", description: @tr("显示在数值后的单位，如 %、°C。") },
            { name: "enabled", kind: @tr("属性"), type: "bool", description: @tr("禁用后变暗且不可操作。") },
            { name: "needle-angle", kind: @tr("输出"), type: "angle", description: @tr("指示点角度，范围 -135° 到 135°。") },
            { name: "value-changed(float)", kind: @tr("回调"), type: "", description: @tr("用户调整数值后触发；宿主赋值不会触发。") },
            { name: "set-value(float)", kind: @tr("函数"), type: "", description: @tr("按范围约束设置数值并触发 value-changed。") },
        ];

        GalleryExample {
            title: @tr("基本用法");
            description: @tr("拖动旋钮或滑块调整同一数值；聚焦后可用方向键、Home 与 End。");
            output: @tr("value-changed · {}", Math.round(dial.value * 100) / 100);
            GalleryPreview {
                spacing: 24px;
                dial := ForgeDial {
                    width: 180px; height: 180px;
                    value <=> root.number; minimum: 0; maximum: 100;
                    step: root.step; suffix: "%"; enabled: !root.disabled;
                }
                VerticalLayout {
                    alignment: center;
                    Slider { width: 160px; minimum: 0; maximum: 100; value <=> root.number; enabled: !root.disabled; }
                }
            }
            GalleryOptions {
                Text { text: "step"; color: Palette.foreground.transparentize(0.45); font-size: 12px * ForgeTypography.scale; }
                SpinBox { minimum: 1; maximum: 20; value <=> root.step; }
                CheckBox { text: @tr("禁用"); checked <=> root.disabled; }
            }
        }

        GalleryExample {
            title: @tr("状态对照");
            description: @tr("最小值、中间值与禁用状态。");
            GalleryPreview {
                content-padding: 16px;
                GalleryVariant { caption: "value: 0"; ForgeDial { width: 120px; height: 120px; value: 0; } }
                GalleryVariant { caption: "value: 50"; ForgeDial { width: 120px; height: 120px; value: 50; } }
                GalleryVariant { caption: "enabled: false"; ForgeDial { width: 120px; height: 120px; value: 75; enabled: false; } }
            }
        }

        GalleryExample {
            title: @tr("空调温控");
            description: @tr("在 16～30 °C 之间以 0.5 °C 步长设定目标温度，根据室温显示运行模式。");
            output: @tr("目标 {}°C · 室温 {}°C", root.target, root.room);
            GalleryPreview {
                Rectangle {
                    width: panel.preferred-width;
                    height: panel.preferred-height;
                    border-radius: 8px; border-width: 1px; border-color: Palette.border;
                    background: Palette.background;
                    panel := HorizontalLayout {
                        padding: 20px; spacing: 24px;
                        ForgeDial {
                            width: 160px; height: 160px;
                            minimum: 16; maximum: 30; step: 0.5; suffix: "°C";
                            value <=> root.target;
                        }
                        VerticalLayout {
                            spacing: 8px; alignment: center;
                            Text { text: @tr("客厅空调"); color: Palette.foreground; font-size: 16px * ForgeTypography.scale; font-weight: 600; }
                            Text { text: @tr("室温 {}°C", root.room); color: Palette.foreground.transparentize(0.3); }
                            Text {
                                text: root.target < root.room ? @tr("制冷中") : root.target > root.room ? @tr("制热中") : @tr("保持温度");
                                color: Palette.accent-background; font-weight: 600;
                            }
                            HorizontalLayout {
                                spacing: 6px; padding-top: 4px;
                                Button { text: @tr("舒适 24°C"); clicked => { root.target = 24; } }
                                Button { text: @tr("节能 26°C"); clicked => { root.target = 26; } }
                            }
                        }
                    }
                }
            }
        }
    }
}
