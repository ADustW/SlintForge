import { Palette } from "std-widgets.slint";
import { ForgeTypography } from "@slintforge";
import { GalleryPageFrame } from "../component/page-frame.slint";

// Gallery 关于页：版本与项目说明。
export component GalleryAboutPage inherits Rectangle {
    in property<string> version-text;
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    callback prepare-preview(bool);
    prepare-preview(open) => {  }

    GalleryPageFrame {
        width: parent.width; height: parent.height;
        title: "About";
        subtitle: @tr("SlintForge 组件与示例应用。");
        Rectangle {
            border-radius: 8px; border-width: 1px; border-color: Palette.border;
            background: Palette.alternate-background;
            height: card.preferred-height;
            card := VerticalLayout {
                padding: 24px; spacing: 12px;
                Text { text: "SlintForge Gallery · " + root.version-text; color: Palette.foreground; font-size: 24px * ForgeTypography.scale; font-weight: 600; }
                Text { text: @tr("共享 Slint 组件 · Rust / C++ SDK\n96 个导航页面已全部提供演示。\n原生控件示例与组件 API 使用同一套 UI 契约。"); color: Palette.foreground.transparentize(0.25); font-size: 13px * ForgeTypography.scale; wrap: word-wrap; }
            }
        }
    }
}
