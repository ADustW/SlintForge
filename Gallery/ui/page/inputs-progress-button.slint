import { CheckBox, Palette, ProgressIndicator } from "std-widgets.slint";
import { ForgeProgressButton, ForgeTypography } from "@slintforge";
import { GalleryComponentPage, GalleryExample, GalleryPreview, GalleryOptions, GalleryVariant } from "../component/component-page.slint";

// 共享组件演示：ProgressButton。
export component GalleryInputsProgressButtonPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    in-out property<bool> busy: false;
    private property<bool> disabled: false;
    private property<bool> uploading: false;
    private property<float> uploaded: 0;
    private property<string> upload-status: @tr("3 个文件待上传，共 4.2 MB");
    callback prepare-preview(bool);
    prepare-preview(open) => { root.busy = open; }

    GalleryComponentPage {
        width: parent.width; height: parent.height;
        category: @tr("输入 / 按钮");
        title: "ProgressButton";
        subtitle: @tr("执行耗时操作的主按钮。忙碌时显示加载指示和进度并自动禁用，防止重复提交。");
        showcase-route: "inputs-progress-button";
        qa-anchors: [states.y, scenario.y];
        api: [
            { name: "text", kind: @tr("属性"), type: "string", description: @tr("空闲时的按钮文字。") },
            { name: "busy", kind: @tr("属性"), type: "bool", description: @tr("为 true 时显示加载指示并禁用按钮。") },
            { name: "progress", kind: @tr("属性"), type: "float", description: @tr("0～1 的进度，显示为百分比；小于 0 时显示“处理中…”。") },
            { name: "enabled", kind: @tr("属性"), type: "bool", description: @tr("禁用按钮。") },
            { name: "clicked()", kind: @tr("回调"), type: "", description: @tr("空闲时点击触发，通常在此开始任务并设置 busy。") },
        ];

        GalleryExample {
            title: @tr("基本用法");
            description: @tr("点击后模拟一个 2 秒的任务；关闭 progress 后改为不确定进度。");
            output: root.busy ? @tr("busy · {}%", round(root.number)) : root.status;
            GalleryPreview {
                ForgeProgressButton {
                    text: @tr("开始任务"); busy: root.busy; enabled: !root.disabled;
                    progress: root.flag ? root.number / 100 : -1;
                    clicked => { root.number = 0; root.busy = true; }
                }
            }
            GalleryOptions {
                CheckBox { text: "progress"; checked <=> root.flag; }
                CheckBox { text: @tr("禁用"); checked <=> root.disabled; }
            }
        }

        states := GalleryExample {
            title: @tr("状态对照");
            description: @tr("空闲、不确定进度与确定进度三种状态。");
            GalleryPreview {
                content-padding: 16px;
                GalleryVariant { caption: "busy: false"; ForgeProgressButton { text: @tr("提交"); } }
                GalleryVariant { caption: "progress: -1"; ForgeProgressButton { text: @tr("提交"); busy: true; } }
                GalleryVariant { caption: "progress: 0.65"; ForgeProgressButton { text: @tr("提交"); busy: true; progress: 0.65; } }
            }
        }

        scenario := GalleryExample {
            title: @tr("上传附件");
            description: @tr("上传期间按钮显示总进度，完成后恢复可用。");
            output: root.upload-status;
            GalleryPreview {
                Rectangle {
                    width: 400px * ForgeTypography.scale;
                    height: card.preferred-height;
                    border-radius: 8px; border-width: 1px; border-color: Palette.border;
                    background: Palette.background;
                    card := VerticalLayout {
                        padding: 20px; spacing: 10px;
                        for file in [
                            { name: "contract.pdf", size: "1.8 MB" },
                            { name: "invoice-0925.xlsx", size: "0.6 MB" },
                            { name: "site-photo.jpg", size: "1.8 MB" },
                        ] : HorizontalLayout {
                            spacing: 8px;
                            Text { text: file.name; color: Palette.foreground; horizontal-stretch: 1; }
                            Text { text: file.size; color: Palette.foreground.transparentize(0.45); font-size: 12px * ForgeTypography.scale; }
                        }
                        ProgressIndicator { height: 6px; progress: root.uploaded / 100; }
                        HorizontalLayout {
                            alignment: end;
                            ForgeProgressButton {
                                text: @tr("上传"); busy: root.uploading; progress: root.uploaded / 100;
                                clicked => { root.uploaded = 0; root.uploading = true; root.upload-status = @tr("正在上传…"); }
                            }
                        }
                    }
                }
            }
        }
    }

    Timer {
        interval: 100ms; running: root.busy && root.visible;
        triggered => {
            root.number += 5;
            if root.number >= 100 { root.busy = false; root.count += 1; root.status = @tr("clicked · 任务已完成 {} 次", root.count); }
        }
    }
    Timer {
        interval: 80ms; running: root.uploading && root.visible;
        triggered => {
            root.uploaded += 4;
            if root.uploaded >= 100 { root.uploading = false; root.upload-status = @tr("3 个文件已上传"); }
        }
    }
}
