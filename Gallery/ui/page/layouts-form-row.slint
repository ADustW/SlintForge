import { Palette } from "std-widgets.slint";
import { ForgeFormRow, ForgeIconButton, ForgeTypography } from "@slintforge";
import { GalleryPageFrame } from "../component/page-frame.slint";
import { GalleryDemoCard } from "../component/demo-card.slint";

export component GalleryFormRowPage inherits Rectangle {
    in-out property<bool> narrow: false;
    GalleryPageFrame {
        width: parent.width; height: parent.height;
        title: "FormRow";
        subtitle: @tr("宽屏时控件靠右；宽度低于断点后，控件移到标题和说明下方。");
        HorizontalLayout {
            height: 34px; vertical-stretch: 0; spacing: 8px;
            ForgeIconButton { label: @tr("宽屏预览"); selected: !root.narrow; clicked => { root.narrow = false; } }
            ForgeIconButton { label: @tr("窄屏预览"); selected: root.narrow; clicked => { root.narrow = true; } }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.narrow ? @tr("小于 560px") : @tr("不小于 560px"); color: Palette.foreground; vertical-alignment: center; font-size: 13px * ForgeTypography.scale; }
        }
        Text { text: @tr("用法与状态"); height: self.preferred-height; vertical-stretch: 0; color: Palette.foreground; font-weight: 600; }
        preview := GalleryDemoCard {
            preview-height: 380px;
            Rectangle {
                x: 18px; y: 16px;
                width: root.narrow ? Math.min(430px, preview.width - 36px) : Math.max(0px, preview.width - 36px);
                height: preview.height - 32px;
                background: Palette.background;
                VerticalLayout {
                    x: 20px; y: 20px;
                    width: Math.max(0px, parent.width - 40px);
                    spacing: 16px;
                    ForgeFormRow {
                        width: parent.width;
                        height: self.stacked-layout ? 102px : 76px;
                        title: @tr("工作区名称");
                        description: @tr("用于在设置页和窗口标题中区分工作区。");
                        Rectangle {
                            width: 190px; height: 34px;
                            background: #3762a8; border-radius: 5px;
                            Text { text: @tr("名称控件"); color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    ForgeFormRow {
                        width: parent.width;
                        height: self.stacked-layout ? 102px : 76px;
                        title: @tr("同步策略");
                        description: @tr("调整后台任务的默认运行方式。");
                        Rectangle {
                            width: 148px; height: 34px;
                            background: #247b6f; border-radius: 5px;
                            Text { text: @tr("策略控件"); color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    ForgeFormRow {
                        width: parent.width;
                        height: self.stacked-layout ? 102px : 76px;
                        title: @tr("通知级别");
                        description: @tr("仅显示与当前工作相关的通知。");
                        Rectangle {
                            width: 120px; height: 34px;
                            background: #8756aa; border-radius: 5px;
                            Text { text: @tr("级别控件"); color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

    }
}
