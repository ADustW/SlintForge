import { CheckBox, LineEdit, Palette } from "std-widgets.slint";
import { ForgeIconButton, ForgeTypography } from "@slintforge";
import { GalleryComponentPage, GalleryExample, GalleryPreview, GalleryOptions, GalleryVariant } from "../component/component-page.slint";

// 共享组件演示：IconButton。
export component GalleryIconButtonPage inherits Rectangle {
    in-out property<int> click-count: 0;
    in-out property<bool> selected: false;
    private property<string> icon-text: "★";
    private property<string> label-text: @tr("收藏");
    private property<bool> disabled: false;
    private property<bool> bold: true;
    private property<bool> italic: false;
    private property<bool> underline: false;
    private property<int> align: 0;
    background: transparent;

    GalleryComponentPage {
        width: parent.width; height: parent.height;
        category: @tr("输入 / 按钮");
        title: "IconButton";
        subtitle: @tr("由图标字符和可选文字组成的紧凑按钮，可显示选中状态，适合工具栏和格式栏。");
        api: [
            { name: "icon", kind: @tr("属性"), type: "string", description: @tr("图标字符；为空时只显示文字。") },
            { name: "label", kind: @tr("属性"), type: "string", description: @tr("按钮文字；为空时按钮为 36px 宽的方形。") },
            { name: "selected", kind: @tr("属性"), type: "bool", description: @tr("以主色背景显示选中状态，由外部维护。") },
            { name: "enabled", kind: @tr("属性"), type: "bool", description: @tr("禁用后半透明显示并不响应点击。") },
            { name: "clicked()", kind: @tr("回调"), type: "", description: @tr("鼠标单击时触发。") },
        ];

        GalleryExample {
            title: @tr("基本用法");
            description: @tr("selected 不会自动切换，示例在 clicked 中取反实现开关效果。");
            output: @tr("clicked · 已点击 {} 次 · selected: {}", root.click-count, root.selected ? "true" : "false");
            GalleryPreview {
                ForgeIconButton {
                    icon: root.icon-text; label: root.label-text; selected: root.selected; enabled: !root.disabled;
                    clicked => { root.click-count += 1; root.selected = !root.selected; }
                }
            }
            GalleryOptions {
                CheckBox { text: "selected"; checked <=> root.selected; }
                CheckBox { text: @tr("禁用"); checked <=> root.disabled; }
                Text { text: "icon"; color: Palette.foreground.transparentize(0.45); font-size: 12px * ForgeTypography.scale; }
                LineEdit { text <=> root.icon-text; }
                Text { text: "label"; color: Palette.foreground.transparentize(0.45); font-size: 12px * ForgeTypography.scale; }
                LineEdit { text <=> root.label-text; }
            }
        }

        states := GalleryExample {
            title: @tr("状态对照");
            description: @tr("仅图标、选中与禁用三种状态。");
            GalleryPreview {
                content-padding: 16px;
                GalleryVariant { caption: "label: \"\""; ForgeIconButton { icon: "⚙"; } }
                GalleryVariant { caption: "selected: true"; ForgeIconButton { icon: "★"; label: @tr("已收藏"); selected: true; } }
                GalleryVariant { caption: "enabled: false"; ForgeIconButton { icon: "↻"; label: @tr("刷新"); enabled: false; } }
            }
        }

        scenario := GalleryExample {
            title: @tr("文本格式栏");
            description: @tr("加粗、斜体、下划线可同时选中；对齐方式三选一。");
            output: (root.bold ? "bold " : "") + (root.italic ? "italic " : "") + (root.underline ? "underline " : "") + "· " + (root.align == 0 ? "left" : root.align == 1 ? "center" : "right");
            GalleryPreview {
                Rectangle {
                    width: bar.preferred-width;
                    height: bar.preferred-height;
                    border-radius: 8px; border-width: 1px; border-color: Palette.border;
                    background: Palette.background;
                    bar := VerticalLayout {
                        padding: 12px; spacing: 12px;
                        HorizontalLayout {
                            spacing: 4px; alignment: start;
                            ForgeIconButton { icon: "B"; selected: root.bold; clicked => { root.bold = !root.bold; } }
                            ForgeIconButton { icon: "I"; selected: root.italic; clicked => { root.italic = !root.italic; } }
                            ForgeIconButton { icon: "U"; selected: root.underline; clicked => { root.underline = !root.underline; } }
                            Rectangle { width: 12px; }
                            ForgeIconButton { icon: "⇤"; label: @tr("左对齐"); selected: root.align == 0; clicked => { root.align = 0; } }
                            ForgeIconButton { icon: "↔"; label: @tr("居中"); selected: root.align == 1; clicked => { root.align = 1; } }
                            ForgeIconButton { icon: "⇥"; label: @tr("右对齐"); selected: root.align == 2; clicked => { root.align = 2; } }
                        }
                        Text {
                            text: @tr("示例文字 Sample Text");
                            color: Palette.foreground; font-size: 16px * ForgeTypography.scale;
                            font-weight: root.bold ? 700 : 400; font-italic: root.italic;
                            horizontal-alignment: root.align == 0 ? TextHorizontalAlignment.left : root.align == 1 ? TextHorizontalAlignment.center : TextHorizontalAlignment.right;
                        }
                    }
                }
            }
        }
    }
}
