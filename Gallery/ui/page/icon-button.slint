import { ForgeTypography } from "@slintforge";
import { Palette } from "std-widgets.slint";
import { ForgeIconButton } from "@slintforge";
import { GalleryPageFrame } from "../component/page-frame.slint";
import { GalleryDemoCard } from "../component/demo-card.slint";

export component GalleryIconButtonPage inherits Rectangle {
    in-out property<int> click-count: 0;
    in-out property<bool> selected: false;
    background: transparent;

    GalleryPageFrame {
        width: parent.width;
        height: parent.height;
        title: "IconButton";
        subtitle: @tr("图标与文字按钮 · ForgeIconButton");
        Text { text: @tr("用法与状态"); height: self.preferred-height; vertical-stretch: 0; color: Palette.foreground; font-weight: 600; }
        GalleryDemoCard {
            preview-height: 130px;
            HorizontalLayout {
                x: 20px; y: (parent.height - 34px) / 2; width: parent.width - 40px; height: 34px;
                spacing: 12px;
                ForgeIconButton { icon: "+"; label: @tr("点击计数"); clicked => { root.click-count += 1; } }
                ForgeIconButton { icon: "★"; label: @tr("可选中"); selected: root.selected; clicked => { root.selected = !root.selected; } }
                ForgeIconButton { icon: "×"; label: @tr("禁用"); enabled: false; }
                Text { text: @tr("点击 {} 次", root.click-count); color: Palette.foreground; vertical-alignment: center; }
            }
        }
        Text { text: @tr("内容组合"); height: self.preferred-height; vertical-stretch: 0; color: Palette.foreground; font-weight: 600; }
        GalleryDemoCard {
            preview-height: 115px;
            HorizontalLayout {
                x: 20px; y: (parent.height - 34px) / 2; width: parent.width - 40px; height: 34px;
                spacing: 12px;
                ForgeIconButton { icon: "?"; }
                ForgeIconButton { label: @tr("仅文字"); }
                ForgeIconButton { icon: "↗"; label: @tr("图文组合"); }
            }
        }
}
}
