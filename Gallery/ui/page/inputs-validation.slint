import { Button, Palette } from "std-widgets.slint";
import { ForgeInputValidation, ForgeTypography } from "@slintforge";
import { GallerySamplePage } from "../component/sample-page.slint";
import { GalleryDemoModels } from "../component/demo-models.slint";

// 共享组件演示：InputValidation。
export component GalleryInputsValidationPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    callback prepare-preview(bool);
    prepare-preview(open) => {  }
    
    sample := GallerySamplePage {
        showcase-route: "inputs-validation";
        active: root.visible;
        title: "InputValidation";
        subtitle: @tr("输入文字后验证长度与必填规则。");
        example-title: @tr("用法与状态");
        preview-height: 210px * ForgeTypography.scale;
        VerticalLayout {
            x: 20px; y: 20px; width: Math.max(0px, Math.min(620px, sample.preview-width - 40px));
            height: Math.max(0px, sample.preview-area-height - 40px);
            spacing: 16px; alignment: start;
            validated := ForgeInputValidation { minimum-length: 3; maximum-length: 24; placeholder-text: @tr("请输入 3～24 个字符"); touched: true; accepted(value) => { root.status = value; } }
Button { text: @tr("验证"); clicked => { validated.touched = true; root.status = validated.valid ? @tr("验证通过") : validated.validation-message; } }
Text { text: root.status; color: Palette.foreground; wrap: word-wrap; }
        }
    }
    
}
