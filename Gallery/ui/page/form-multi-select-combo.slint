import { ForgeMultiSelectComboBox, ForgeTypography } from "@slintforge";
import { GallerySamplePage } from "../component/sample-page.slint";
import { GalleryDemoModels } from "../component/demo-models.slint";

// 共享组件演示：MultiSelectComboBox。
export component GalleryFormMultiSelectComboPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    callback prepare-preview(bool);
    prepare-preview(open) => { if open { control.show(); } else { control.close(); } }
    
    sample := GallerySamplePage {
        title: "MultiSelectComboBox";
        subtitle: @tr("展开列表，选中多个选项。");
        example-title: @tr("用法与状态");
        preview-height: 120px * ForgeTypography.scale;
        VerticalLayout {
            x: 20px; y: 20px; width: Math.max(0px, Math.min(620px, sample.preview-width - 40px));
            height: Math.max(0px, sample.preview-area-height - 40px);
            spacing: 16px; alignment: start;
            control := ForgeMultiSelectComboBox { items: [{id: "rust", label: "Rust", enabled: true, selected: true}, {id: "cpp", label: "C++", enabled: true}, {id: "slint", label: "Slint", enabled: true}, {id: "disabled", label: @tr("禁用选项"), enabled: false}]; selection-text: root.draft; selection-changed(id, selected) => { root.draft = id + (selected ? " +" : " −"); } }
        }
    }
    
}
