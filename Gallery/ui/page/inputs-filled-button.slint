import { Button, CheckBox, LineEdit, Palette } from "std-widgets.slint";
import { ForgeTypography } from "@slintforge";
import { GalleryComponentPage, GalleryExample, GalleryPreview, GalleryOptions, GalleryVariant } from "../component/component-page.slint";

// Slint 原生示例：FilledButton（Button.primary）。
export component GalleryInputsFilledButtonPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft: @tr("提交");
    in-out property<string> status: @tr("就绪");
    private property<bool> disabled: false;
    private property<bool> agreed: false;
    callback prepare-preview(bool);
    prepare-preview(open) => {  }

    GalleryComponentPage {
        width: parent.width; height: parent.height;
        category: @tr("输入 / 按钮");
        title: "FilledButton";
        subtitle: @tr("设置 primary: true 的原生 Button，以主色填充突出当前界面最重要的操作。一组按钮中通常只放一个。");
        native: true;
        showcase-route: "inputs-filled-button";
        qa-anchors: [states.y, scenario.y];
        api: [
            { name: "primary", kind: @tr("属性"), type: "bool", description: @tr("设为 true 时使用主色填充。") },
            { name: "text", kind: @tr("属性"), type: "string", description: @tr("按钮文字。") },
            { name: "enabled", kind: @tr("属性"), type: "bool", description: @tr("禁用后显示为灰色并不响应操作。") },
            { name: "pressed / has-focus", kind: @tr("输出"), type: "bool", description: @tr("按下与焦点状态。") },
            { name: "clicked()", kind: @tr("回调"), type: "", description: @tr("鼠标单击，或聚焦时按 Enter / Space 触发。") },
        ];

        GalleryExample {
            title: @tr("基本用法");
            description: @tr("关闭 primary 可与普通按钮对比。");
            output: @tr("clicked · 已点击 {} 次", root.count);
            GalleryPreview {
                Button { text: root.draft; primary: root.flag; enabled: !root.disabled; clicked => { root.count += 1; } }
            }
            GalleryOptions {
                CheckBox { text: "primary"; checked <=> root.flag; }
                CheckBox { text: @tr("禁用"); checked <=> root.disabled; }
                Text { text: "text"; color: Palette.foreground.transparentize(0.45); font-size: 12px * ForgeTypography.scale; }
                LineEdit { text <=> root.draft; }
            }
        }

        states := GalleryExample {
            title: @tr("状态对照");
            description: @tr("主色按钮的可用与禁用状态，以及与普通按钮的对比。");
            GalleryPreview {
                content-padding: 16px;
                GalleryVariant { caption: "primary: true"; Button { text: @tr("保存"); primary: true; } }
                GalleryVariant { caption: "enabled: false"; Button { text: @tr("保存"); primary: true; enabled: false; } }
                GalleryVariant { caption: "primary: false"; Button { text: @tr("保存"); } }
            }
        }

        scenario := GalleryExample {
            title: @tr("服务条款确认");
            description: @tr("勾选同意后主按钮才可用；“拒绝”保持普通样式。");
            output: root.status;
            GalleryPreview {
                Rectangle {
                    width: 420px * ForgeTypography.scale;
                    height: card.preferred-height;
                    border-radius: 8px; border-width: 1px; border-color: Palette.border;
                    background: Palette.background;
                    card := VerticalLayout {
                        padding: 20px; spacing: 14px;
                        Text { text: @tr("开始使用前，需要同意服务条款与隐私政策。"); color: Palette.foreground; font-size: 14px * ForgeTypography.scale; wrap: word-wrap; }
                        CheckBox { text: @tr("我已阅读并同意"); checked <=> root.agreed; }
                        HorizontalLayout {
                            spacing: 8px; alignment: end;
                            Button { text: @tr("拒绝"); clicked => { root.status = @tr("已拒绝条款"); } }
                            Button { text: @tr("同意并继续"); primary: true; enabled: root.agreed; clicked => { root.status = @tr("已同意条款"); } }
                        }
                    }
                }
            }
        }
    }
}
