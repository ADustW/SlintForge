import { Palette, ScrollView } from "std-widgets.slint";
import { ForgeIcon, ForgeIcons, ForgeNavPlacement, ForgePaneState, ForgeTypography, ForgeMetrics } from "@slintforge";

struct GalleryHomeEntry { icon: string, title: string, description: string, route: string }

component GalleryHomeTile inherits Rectangle {
    in property<GalleryHomeEntry> entry;
    callback clicked();
    border-radius: ForgeMetrics.surface-radius;
    border-width: 1px;
    border-color: tile-touch.has-hover ? Palette.accent-background : Palette.card-stroke;
    background: tile-touch.pressed ? Palette.control-tertiary : tile-touch.has-hover ? Palette.control-secondary : Palette.card-background;
    animate background, border-color { duration: 100ms; }
    accessible-role: button; accessible-label: root.entry.title;
    accessible-action-default => { root.clicked(); }
    forward-focus: tile-focus;
    HorizontalLayout {
        padding: 16px; spacing: 12px;
        Rectangle {
            width: 32px * ForgeTypography.scale; height: self.width;
            horizontal-stretch: 0; vertical-stretch: 0;
            border-radius: 6px;
            background: Palette.accent-surface;
            ForgeIcon { glyph: root.entry.icon; color: Palette.accent-background; font-size: 20px * ForgeTypography.scale; }
        }
        VerticalLayout {
            alignment: center; spacing: 4px;
            Text { text: root.entry.title; color: Palette.foreground; font-size: ForgeTypography.body; font-weight: 600; overflow: elide; }
            Text {
                text: root.entry.description; color: Palette.text-secondary;
                font-size: ForgeTypography.caption; wrap: word-wrap; overflow: elide;
                max-height: 32px * ForgeTypography.scale;
            }
        }
        ForgeIcon {
            width: 12px; horizontal-stretch: 0;
            glyph: ForgeIcons.chevron-right; font-size: 12px;
            color: tile-touch.has-hover ? Palette.accent-background : Palette.text-tertiary;
        }
    }
    tile-focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; }
    }
    if tile-focus.has-focus : Rectangle {
        border-width: 2px; border-color: Palette.focus-stroke-outer;
        border-radius: ForgeMetrics.surface-radius; background: transparent;
    }
    tile-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// 列数随实际可用宽度和字体缩放变化，最低尺寸通过局部滚动展示全部内容。
component GalleryHomeSection inherits Rectangle {
    in property<string> title;
    in property<int> desired-columns: 4;
    in property<length> tile-height: 80px * ForgeTypography.scale;
    in property<[GalleryHomeEntry]> entries;
    callback navigate-requested(string);
    property<int> columns: Math.max(1, Math.min(root.desired-columns, floor((root.width + root.gap) / (228px * ForgeTypography.scale + root.gap))));
    property<length> gap: 12px;
    property<length> tile-width: (root.width - (root.columns - 1) * root.gap) / root.columns;
    property<length> header-height: root.title == "" ? 0px : 28px + 24px * ForgeTypography.scale;
    height: root.header-height + ceil(root.entries.length / root.columns) * (root.tile-height + root.gap) - root.gap;
    vertical-stretch: 0;
    if root.title != "" : Rectangle { x: 0px; y: 0px; width: root.width; height: 1px; background: Palette.divider; }
    if root.title != "" : Text {
        x: 0px; y: 16px; width: root.width;
        text: root.title; color: Palette.foreground; font-size: ForgeTypography.subtitle; font-weight: 600;
    }
    for entry[index] in root.entries : GalleryHomeTile {
        x: mod(index, root.columns) * (root.tile-width + root.gap);
        y: root.header-height + floor(index / root.columns) * (root.tile-height + root.gap);
        width: root.tile-width; height: root.tile-height;
        entry: entry;
        clicked => { root.navigate-requested(entry.route); }
    }
}

export component GalleryHomePage inherits Rectangle {
    callback navigate-requested(string);
    callback placement-requested(ForgeNavPlacement);
    callback pane-requested(ForgePaneState);
    background: Palette.content-background;

    scroll := ScrollView {
        width: parent.width; height: parent.height;
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            width: scroll.visible-width;
            alignment: start;
            padding: root.width < 720px ? ForgeMetrics.space-l : ForgeMetrics.page-padding;
            spacing: 24px;
            VerticalLayout {
                spacing: 8px;
                Text { text: "SlintForge Gallery"; color: Palette.foreground; font-size: ForgeTypography.title; font-weight: 600; }
                Text {
                    text: @tr("一套 Slint 组件，同时服务 Rust 与 C++ 应用。每个页面都可以直接操作、切换属性并查看 API。");
                    color: Palette.text-secondary; font-size: ForgeTypography.body; wrap: word-wrap;
                }
            }
            Rectangle { height: 1px; background: Palette.divider; }
            GalleryHomeSection {
                desired-columns: 3; tile-height: 88px * ForgeTypography.scale;
                entries: [
                    { icon: "\u{f677}", title: @tr("开始使用"), description: @tr("从按钮开始浏览可交互示例"), route: "inputs-pill-button" },
                    { icon: ForgeIcons.apps, title: @tr("组件目录"), description: @tr("按分类浏览全部组件页面"), route: "navigation" },
                    { icon: ForgeIcons.settings, title: @tr("外观与语言"), description: @tr("切换主题、字体与导航位置"), route: "settings" },
                ];
                navigate-requested(id) => { root.navigate-requested(id); }
            }
            GalleryHomeSection {
                title: @tr("精选组件");
                entries: [
                    { icon: "\u{e457}", title: "ForgePlot", description: @tr("专业绘图，支持缩放、测量与导出"), route: "chart-professional" },
                    { icon: "\u{f75d}", title: "DataGrid", description: @tr("排序、筛选、冻结列与单元格编辑"), route: "data-grid" },
                    { icon: "\u{e637}", title: "ForgeFlow", description: @tr("节点与连线编辑器"), route: "flow-basic" },
                    { icon: ForgeIcons.window, title: "ForgeWindow", description: @tr("无边框窗口与标题栏"), route: "forge-window" },
                ];
                navigate-requested(id) => { root.navigate-requested(id); }
            }
            GalleryHomeSection {
                title: @tr("常用示例");
                entries: [
                    { icon: ForgeIcons.search, title: "AutoSuggestBox", description: @tr("输入时给出建议并快速选择"), route: "form-auto-suggest" },
                    { icon: "\u{f33f}", title: "Bar Chart", description: @tr("比较各月份数据，切换分组或堆叠"), route: "chart-bar" },
                    { icon: ForgeIcons.calendar, title: "CalendarPicker", description: @tr("紧凑的日期与时间选择"), route: "form-calendar-picker" },
                    { icon: "\u{e78f}", title: "PasswordBox", description: @tr("隐藏输入内容的密码框"), route: "form-password-box" },
                ];
                navigate-requested(id) => { root.navigate-requested(id); }
            }
        }
    }
}
