import { Palette, ScrollView } from "std-widgets.slint";
import { ForgeIcon, ForgeIcons, ForgeNavPlacement, ForgePaneState, ForgeTypography } from "@slintforge";

struct GalleryHomeEntry { icon: string, title: string, description: string, route: string }

component GalleryHomeTile inherits Rectangle {
    in property<GalleryHomeEntry> entry;
    callback clicked();
    border-radius: 8px;
    border-width: 1px;
    border-color: tile-touch.has-hover ? Palette.accent-background.transparentize(0.4) : Palette.border;
    background: tile-touch.has-hover ? Palette.control-background : Palette.alternate-background;
    animate background, border-color { duration: 120ms; }
    Rectangle {
        x: 16px; y: 16px; width: 40px * ForgeTypography.scale; height: self.width;
        border-radius: 8px;
        background: Palette.accent-background.transparentize(0.85);
        ForgeIcon { glyph: root.entry.icon; color: Palette.accent-background; font-size: 20px * ForgeTypography.scale; }
    }
    Text {
        x: 16px + 40px * ForgeTypography.scale + 14px; y: 16px;
        width: parent.width - self.x - 32px;
        vertical-alignment: top;
        text: root.entry.title; color: Palette.foreground;
        font-size: 14px * ForgeTypography.scale; font-weight: 600; overflow: elide;
    }
    Text {
        x: 16px + 40px * ForgeTypography.scale + 14px; y: 16px + 24px * ForgeTypography.scale;
        width: parent.width - self.x - 16px; height: parent.height - self.y - 12px;
        text: root.entry.description; color: Palette.foreground.transparentize(0.35);
        font-size: 12px * ForgeTypography.scale; wrap: word-wrap; overflow: elide; vertical-alignment: top;
    }
    ForgeIcon {
        x: parent.width - 30px; y: 18px; width: 16px; height: 16px;
        glyph: ForgeIcons.chevron-right; font-size: 12px * ForgeTypography.scale;
        color: Palette.foreground.transparentize(tile-touch.has-hover ? 0.2 : 0.6);
    }
    tile-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// 按可用宽度排成 4 列或 2 列。
component GalleryHomeSection inherits Rectangle {
    in property<string> title;
    in property<[GalleryHomeEntry]> entries;
    callback navigate-requested(string);
    property<int> columns: root.width >= 860px ? 4 : 2;
    property<length> gap: 12px;
    property<length> tile-height: 96px * ForgeTypography.scale;
    property<length> tile-width: (root.width - (root.columns - 1) * root.gap) / root.columns;
    property<length> header-height: 40px * ForgeTypography.scale;
    height: root.header-height + ceil(root.entries.length / root.columns) * (root.tile-height + root.gap) - root.gap;
    vertical-stretch: 0;
    Text { x: 0px; y: 0px; width: root.width; text: root.title; color: Palette.foreground; font-size: 20px * ForgeTypography.scale; font-weight: 600; }
    for entry[index] in root.entries : GalleryHomeTile {
        x: mod(index, root.columns) * (root.tile-width + root.gap);
        y: root.header-height + floor(index / root.columns) * (root.tile-height + root.gap);
        width: root.tile-width; height: root.tile-height;
        entry: entry;
        clicked => { root.navigate-requested(entry.route); }
    }
}

component GalleryHeroAction inherits Rectangle {
    in property<string> icon;
    in property<string> title;
    in property<string> description;
    in property<length> card-width: 200px * ForgeTypography.scale;
    callback clicked();
    width: root.card-width;
    height: 112px * ForgeTypography.scale;
    border-radius: 8px;
    background: touch.has-hover ? #ffffff26 : #ffffff14;
    border-width: 1px; border-color: #ffffff24;
    animate background { duration: 120ms; }
    ForgeIcon { x: 16px; y: 16px; width: 24px; height: 24px; glyph: root.icon; color: #c9b2f5; font-size: 20px * ForgeTypography.scale; }
    Text { x: 16px; y: 52px * ForgeTypography.scale; text: root.title; color: white; font-size: 14px * ForgeTypography.scale; font-weight: 600; }
    Text { x: 16px; y: 76px * ForgeTypography.scale; width: parent.width - 32px; text: root.description; color: #ddd3ee; font-size: 12px * ForgeTypography.scale; wrap: word-wrap; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component GalleryHomePage inherits Rectangle {
    callback navigate-requested(string);
    // 导航位置与面板状态由设置页提供；首页保留回调以兼容宿主接线。
    callback placement-requested(ForgeNavPlacement);
    callback pane-requested(ForgePaneState);
    // 三张入口卡片在窄窗口中同步缩窄，避免超出横幅。
    property<length> hero-card-width: Math.min(200px * ForgeTypography.scale, (scroll.visible-width - 64px - 24px) / 3);
    background: Palette.background;

    scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            width: scroll.visible-width;
            spacing: 32px;
            padding-bottom: 40px;
            Rectangle {
                height: 280px * ForgeTypography.scale;
                clip: true;
                background: @linear-gradient(135deg, #1e1530 0%, #3d2368 60%, #1a1229 100%);
                Rectangle {
                    x: parent.width * 0.62; y: 30px; width: 460px; height: 300px;
                    border-radius: 150px;
                    background: #7f4abd40;
                }
                Rectangle {
                    x: parent.width * 0.74; y: 110px; width: 400px; height: 200px;
                    border-radius: 100px;
                    border-width: 2px; border-color: #9d6bd180;
                }
                VerticalLayout {
                    x: 32px; y: 30px; width: parent.width - 64px;
                    spacing: 8px; alignment: start;
                    Text { text: "SlintForge Gallery"; color: white; font-size: 30px * ForgeTypography.scale; font-weight: 700; }
                    Text { text: @tr("一套 Slint 组件，同时服务 Rust 与 C++ 应用。每个页面都可以直接操作、切换属性并查看 API。"); color: #ddd3ee; font-size: 14px * ForgeTypography.scale; wrap: word-wrap; }
                    Rectangle { height: 14px; }
                    HorizontalLayout {
                        spacing: 12px; alignment: start;
                        GalleryHeroAction { card-width: root.hero-card-width; icon: "\u{f677}"; title: @tr("开始使用"); description: @tr("从按钮开始浏览可交互示例"); clicked => { root.navigate-requested("inputs-pill-button"); } }
                        GalleryHeroAction { card-width: root.hero-card-width; icon: ForgeIcons.apps; title: @tr("组件目录"); description: @tr("按分类浏览全部组件页面"); clicked => { root.navigate-requested("navigation"); } }
                        GalleryHeroAction { card-width: root.hero-card-width; icon: ForgeIcons.settings; title: @tr("外观与语言"); description: @tr("切换主题、字体与导航位置"); clicked => { root.navigate-requested("settings"); } }
                    }
                }
            }
            VerticalLayout {
                padding-left: 32px; padding-right: 32px;
                spacing: 32px;
                GalleryHomeSection {
                    title: @tr("精选组件");
                    entries: [
                        { icon: "\u{e457}", title: "ForgePlot", description: @tr("专业绘图，支持缩放、测量与导出"), route: "chart-professional" },
                        { icon: "\u{f75d}", title: "DataGrid", description: @tr("排序、筛选、冻结列与单元格编辑"), route: "data-grid" },
                        { icon: "\u{e637}", title: "ForgeFlow", description: @tr("节点与连线编辑器"), route: "flow-basic" },
                        { icon: ForgeIcons.window, title: "ForgeWindow", description: @tr("无边框窗口与标题栏"), route: "forge-window" },
                    ];
                    navigate-requested(id) => { root.navigate-requested(id); }
                }
                GalleryHomeSection {
                    title: @tr("常用示例");
                    entries: [
                        { icon: ForgeIcons.search, title: "AutoSuggestBox", description: @tr("输入时给出建议并快速选择"), route: "form-auto-suggest" },
                        { icon: "\u{f33f}", title: "Bar Chart", description: @tr("比较各月份数据，切换分组或堆叠"), route: "chart-bar" },
                        { icon: ForgeIcons.calendar, title: "CalendarPicker", description: @tr("紧凑的日期与时间选择"), route: "form-calendar-picker" },
                        { icon: "\u{e78f}", title: "PasswordBox", description: @tr("隐藏输入内容的密码框"), route: "form-password-box" },
                    ];
                    navigate-requested(id) => { root.navigate-requested(id); }
                }
            }
        }
    }
}
