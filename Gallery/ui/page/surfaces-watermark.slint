import { Palette, LineEdit } from "std-widgets.slint";
import { ForgeTypography, ForgeWatermark } from "@slintforge";
import { GallerySamplePage } from "../component/sample-page.slint";

export component GalleryWatermarkPage inherits Rectangle {
    in-out property<string> mark: "SlintForge";
    sample-page := GallerySamplePage {
        width: parent.width; height: parent.height;
        title: "Watermark";
        subtitle: @tr("在容器内容上叠加低对比度的重复水印。");
        preview-height: 300px;

        LineEdit { x: 18px; y: 15px; width: 260px; text: root.mark; placeholder-text: @tr("输入水印文字"); edited(value) => { root.mark = value; } }
        ForgeWatermark {
            x: 18px; y: 64px; width: sample-page.preview-width - 36px; height: sample-page.preview-area-height - 82px;
            mark: root.mark;
            Rectangle {
                x: 28px; y: 30px; width: parent.width - 56px; height: parent.height - 60px;
                border-radius: 8px; background: Palette.background;
                Text { x: 20px; y: 18px; text: @tr("示例文档"); color: Palette.foreground; font-size: 17px * ForgeTypography.scale; font-weight: 600; }
                Text { x: 20px; y: 54px; text: @tr("水印覆盖在内容上方。"); color: Palette.foreground; font-size: 13px * ForgeTypography.scale; }
            }
        }
    }
}
