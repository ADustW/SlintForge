import { Palette } from "std-widgets.slint";
import { ForgeShortcutPicker } from "@slintforge";
import { ForgeTypography } from "@slintforge";
import { GalleryPageFrame } from "../component/page-frame.slint";
import { GalleryPickerExample } from "../component/picker-example.slint";

export component GalleryFormShortcutPickerPage inherits Rectangle {
    in property<string> language: "zh";
    callback prepare-preview(bool);
    prepare-preview(open) => { if open { first.open(); } else { first.close(); second.close(); third.close(); fourth.close(); } }
    GalleryPageFrame {
        width: root.width; height: root.height;
        title: @tr("快捷键选择器"); subtitle: @tr("按下组合键，使用保存、重置或取消提交快捷键。");
        sample := GalleryPickerExample {
            label: @tr("快捷键"); preview-height: 210px * ForgeTypography.scale;
            VerticalLayout {
                alignment: start; spacing: 14px * ForgeTypography.scale;
                HorizontalLayout { alignment: start; spacing: 16px; Text { width: 150px * ForgeTypography.scale; text: @tr("截图"); color: sample.dark ? #fff : #202020; vertical-alignment: center; } first := ForgeShortcutPicker { language: root.language; dark: sample.dark; enabled: !sample.disabled; shortcut: "Alt+A"; } }
                HorizontalLayout { alignment: start; spacing: 16px; Text { width: 150px * ForgeTypography.scale; text: @tr("发送消息"); color: sample.dark ? #fff : #202020; vertical-alignment: center; } second := ForgeShortcutPicker { language: root.language; dark: sample.dark; enabled: !sample.disabled; shortcut: "Enter"; } }
                HorizontalLayout { alignment: start; spacing: 16px; Text { width: 150px * ForgeTypography.scale; text: @tr("打开 Gallery"); color: sample.dark ? #fff : #202020; vertical-alignment: center; } third := ForgeShortcutPicker { language: root.language; dark: sample.dark; enabled: !sample.disabled; shortcut: "Ctrl+Alt+W"; } }
                HorizontalLayout { alignment: start; spacing: 16px; Text { width: 150px * ForgeTypography.scale; text: @tr("锁定 Gallery"); color: sample.dark ? #fff : #202020; vertical-alignment: center; } fourth := ForgeShortcutPicker { language: root.language; dark: sample.dark; enabled: !sample.disabled; shortcut: "Ctrl+L"; } }
            }
        }
    }
}
