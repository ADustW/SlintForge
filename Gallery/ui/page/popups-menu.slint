import { Palette } from "std-widgets.slint";
import { ForgeTypography } from "@slintforge";
import { GallerySamplePage } from "../component/sample-page.slint";
import { GalleryDemoModels } from "../component/demo-models.slint";

// Slint 原生示例：Menu。
export component GalleryPopupsMenuPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    callback prepare-preview(bool);
    prepare-preview(open) => {  }
    
    sample := GallerySamplePage {
        title: "Menu";
        subtitle: @tr("在演示区右击，选择菜单中的操作。");
        example-title: @tr("用法与状态");
        preview-height: 280px * ForgeTypography.scale;
        VerticalLayout {
            x: 20px; y: 20px; width: Math.max(0px, Math.min(620px, sample.preview-width - 40px));
            height: Math.max(0px, sample.preview-area-height - 40px);
            spacing: 16px; alignment: start;
            Rectangle { height: 170px; background: Palette.control-background; border-radius: 8px; Text { text: @tr("在此区域右击打开原生菜单"); color: Palette.foreground; horizontal-alignment: center; vertical-alignment: center; } ContextMenuArea { Menu { MenuItem { title: @tr("打开"); activated => { root.status = @tr("已打开"); } } MenuItem { title: @tr("保存"); activated => { root.status = @tr("已保存"); } } MenuItem { title: @tr("禁用操作"); enabled: false; } } } }
Text { text: root.status; color: Palette.foreground; }
        }
    }
    
}
