import { ForgeDatePicker } from "@slintforge";
import { ForgeTypography } from "@slintforge";
import { GalleryPageFrame } from "../component/page-frame.slint";
import { GalleryPickerExample } from "../component/picker-example.slint";

export component GalleryFormDatePickerPage inherits Rectangle {
    in property<string> language: "zh";
    callback prepare-preview(bool);
    prepare-preview(open) => { if open { first.open(); } else { first.close(); second.close(); } }
    GalleryPageFrame {
        width: root.width; height: root.height;
        title: @tr("日期选择器"); subtitle: @tr("分栏选择年、月、日，支持字段显示和日期范围。");
        sample1 := GalleryPickerExample { label: @tr("默认区域"); first := ForgeDatePicker { x: 0px; y: 0px; language: root.language; dark: sample1.dark; enabled: !sample1.disabled; } }
        sample2 := GalleryPickerExample { label: @tr("英文区域，2000—2100 年"); second := ForgeDatePicker { x: 0px; y: 0px; language: "en"; dark: sample2.dark; enabled: !sample2.disabled; minimum-date: {year: 2000, month: 1, day: 1}; maximum-date: {year: 2100, month: 1, day: 1}; } }
    }
}
