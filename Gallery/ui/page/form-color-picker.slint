import { Palette } from "std-widgets.slint";
import { ForgeColorPicker } from "@slintforge";
import { ForgeTypography } from "@slintforge";
import { GalleryPageFrame } from "../component/page-frame.slint";
import { GalleryPickerExample } from "../component/picker-example.slint";

export component GalleryFormColorPickerPage inherits Rectangle {
    in property<string> language: "zh";
    callback prepare-preview(bool);
    prepare-preview(open) => { if open { picker.open(); } else { picker.close(); } }
    GalleryPageFrame {
        width: root.width; height: root.height;
        title: @tr("颜色选择器"); subtitle: @tr("通过色谱、调色板、十六进制和颜色通道选择颜色，确认后提交。");
        sample := GalleryPickerExample {
            label: @tr("颜色与屏幕取色");
            HorizontalLayout {
                alignment: start; spacing: 12px;
                Text { text: @tr("选择颜色"); color: sample.dark ? #fff : #202020; vertical-alignment: center; }
                picker := ForgeColorPicker { language: root.language; dark: sample.dark; enabled: !sample.disabled; }
            }
        }
    }
}
