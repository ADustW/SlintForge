import { ForgeTypography } from "@slintforge";
import { Palette } from "std-widgets.slint";
import { ForgeCard, ForgeIconButton } from "@slintforge";
import { GalleryPageFrame } from "../component/page-frame.slint";
import { GalleryDemoCard } from "../component/demo-card.slint";

export component GalleryCardPage inherits Rectangle {
    in-out property<int> action-count: 0;
    background: transparent;

    GalleryPageFrame {
        width: parent.width;
        height: parent.height;
        title: "Card";
        subtitle: @tr("带标题的内容容器 · ForgeCard");
        Text { text: @tr("用法与状态"); height: self.preferred-height; vertical-stretch: 0; color: Palette.foreground; font-weight: 600; }
        GalleryDemoCard {
            preview-height: 185px;
            ForgeCard {
                x: 20px; y: 18px; width: parent.width - 40px; height: parent.height - 36px;
                title: @tr("设备状态");
                VerticalLayout {
                    spacing: 8px;
                    Text { text: @tr("将状态、操作和内容放在同一卡片中。"); color: Palette.foreground; }
                    HorizontalLayout {
                        spacing: 10px;
                        ForgeIconButton { icon: "+"; label: @tr("卡片内操作"); clicked => { root.action-count += 1; } }
                        Text { text: @tr("已操作 {} 次", root.action-count); color: Palette.foreground; vertical-alignment: center; }
                    }
                }
            }
        }
        Text { text: @tr("内容组合"); height: self.preferred-height; vertical-stretch: 0; color: Palette.foreground; font-weight: 600; }
        GalleryDemoCard {
            preview-height: 110px;
            ForgeCard {
                x: 20px; y: 13px; width: parent.width - 40px; height: parent.height - 26px;
                title: @tr("概览");
                Text { text: @tr("卡片尺寸由页面控制。"); color: Palette.foreground; }
            }
        }
}
}
