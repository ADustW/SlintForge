import { Button, Palette } from "std-widgets.slint";
import { ForgeAutoSuggestBox, ForgeTypography } from "@slintforge";
import { GallerySamplePage } from "../component/sample-page.slint";
import { GalleryDemoModels } from "../component/demo-models.slint";

// 共享组件演示：AutoSuggestBox。
export component GalleryFormAutoSuggestPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    callback prepare-preview(bool);
    prepare-preview(open) => { suggest.open = open; }
    
    sample := GallerySamplePage {
        title: "AutoSuggestBox";
        subtitle: @tr("输入前缀，展开并选择匹配的建议。");
        example-title: @tr("用法与状态");
        preview-height: 190px * ForgeTypography.scale;
        VerticalLayout {
            x: 20px; y: 20px; width: Math.max(0px, Math.min(620px, sample.preview-width - 40px));
            height: Math.max(0px, sample.preview-area-height - 40px);
            spacing: 16px; alignment: start;
            suggest := ForgeAutoSuggestBox { suggestions: ["Slint", "Slider", "SpinBox", "Switch", "Settings", "Rust", "C++"]; selected(value) => { root.status = value; } }
Button { text: @tr("显示建议"); clicked => { suggest.open = true; } }
Text { text: root.status; color: Palette.foreground; }
        }
    }
    
}
