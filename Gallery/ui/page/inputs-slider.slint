import { Slider, Palette } from "std-widgets.slint";
import { ForgeTypography } from "@slintforge";
import { GallerySamplePage } from "../component/sample-page.slint";
import { GalleryDemoModels } from "../component/demo-models.slint";

// Slint 原生示例：Slider。
export component GalleryInputsSliderPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    callback prepare-preview(bool);
    prepare-preview(open) => {  }
    
    sample := GallerySamplePage {
        showcase-route: "inputs-slider";
        active: root.visible;
        title: "Slider";
        subtitle: @tr("拖动水平或垂直滑块调整数值。");
        example-title: @tr("用法与状态");
        preview-height: 310px * ForgeTypography.scale;
        VerticalLayout {
            x: 20px; y: 20px; width: Math.max(0px, Math.min(620px, sample.preview-width - 40px));
            height: Math.max(0px, sample.preview-area-height - 40px);
            spacing: 16px; alignment: start;
            Slider { minimum: 0; maximum: 100; value <=> root.number; }
    Slider { minimum: 0; maximum: 100; value: 75; enabled: false; }
    HorizontalLayout { height: 130px; spacing: 24px; alignment: start;
        Slider { orientation: vertical; minimum: 0; maximum: 100; value <=> root.number; width: 24px; }
        Slider { orientation: vertical; minimum: 0; maximum: 100; value: 75; enabled: false; width: 24px; }
        Text { text: @tr("当前值：{}", round(root.number)); color: Palette.foreground; vertical-alignment: center; }
    }
        }
    }
    
}
