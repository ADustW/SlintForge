import { Button, CheckBox, LineEdit, Palette, TextEdit } from "std-widgets.slint";
import { ForgeTypography } from "@slintforge";
import { GalleryComponentPage, GalleryExample, GalleryPreview, GalleryOptions } from "../component/component-page.slint";

// Slint 原生示例：CopyableText（TextEdit.read-only / select-all / copy）。
export component GalleryInputsCopyableTextPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    private property<bool> disabled: false;
    private property<string> report-status: @tr("尚未复制");
    callback prepare-preview(bool);
    prepare-preview(open) => {  }

    GalleryComponentPage {
        width: parent.width; height: parent.height;
        category: @tr("输入");
        title: "CopyableText";
        subtitle: @tr("只读但可选择、可复制的文本区域，由原生 TextEdit 设置 read-only 实现，适合展示日志、命令和错误详情。");
        native: true;
        showcase-route: "inputs-copyable-text";
        qa-anchors: [states.y, scenario.y];
        api: [
            { name: "text", kind: @tr("属性"), type: "string", description: @tr("显示的文本。") },
            { name: "read-only", kind: @tr("属性"), type: "bool", description: @tr("为 true 时不可编辑，但仍可选择与复制。") },
            { name: "wrap", kind: @tr("属性"), type: "TextWrap", description: @tr("自动换行方式。") },
            { name: "enabled", kind: @tr("属性"), type: "bool", description: @tr("禁用后不可选择。") },
            { name: "edited(string)", kind: @tr("回调"), type: "", description: @tr("可编辑时内容修改后触发。") },
            { name: "select-all() / copy()", kind: @tr("函数"), type: "", description: @tr("全选文本，并把选中内容复制到剪贴板。") },
            { name: "paste()", kind: @tr("函数"), type: "", description: @tr("在可编辑文本框中粘贴剪贴板内容。") },
        ];

        GalleryExample {
            title: @tr("基本用法");
            description: @tr("用鼠标选择部分文字后按 Ctrl+C，或点击“复制全部”，再粘贴到下方输入框验证。");
            output: root.status;
            GalleryPreview {
                VerticalLayout {
                    width: 360px * ForgeTypography.scale;
                    spacing: 10px;
                    selectable := TextEdit {
                        height: 96px * ForgeTypography.scale;
                        text: "cargo run --release -p slintforge-gallery\nslint-compiler --style fluent ui/main.slint";
                        read-only: root.flag; enabled: !root.disabled;
                        edited(value) => { root.status = @tr("edited · {} 个字符", value.character-count); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: @tr("复制全部"); enabled: !root.disabled;
                            clicked => { selectable.select-all(); selectable.copy(); root.count += 1; root.status = @tr("copy · 已复制 {} 次", root.count); }
                        }
                        LineEdit { placeholder-text: @tr("在此粘贴"); }
                    }
                }
            }
            GalleryOptions {
                CheckBox { text: "read-only"; checked <=> root.flag; }
                CheckBox { text: @tr("禁用"); checked <=> root.disabled; }
            }
        }

        states := GalleryExample {
            title: @tr("状态对照");
            description: @tr("只读文本可选择但不能修改；禁用后既不能编辑也不能选择。");
            GalleryPreview {
                GridLayout {
                    spacing-horizontal: 16px; spacing-vertical: 12px;
                    Row {
                        Text { text: "read-only: true"; color: Palette.foreground.transparentize(0.45); vertical-alignment: center; }
                        TextEdit { width: 280px * ForgeTypography.scale; height: 56px * ForgeTypography.scale; text: "192.168.1.20:8080"; read-only: true; }
                    }
                    Row {
                        Text { text: "read-only: false"; color: Palette.foreground.transparentize(0.45); vertical-alignment: center; }
                        TextEdit { width: 280px * ForgeTypography.scale; height: 56px * ForgeTypography.scale; text: "192.168.1.20:8080"; }
                    }
                    Row {
                        Text { text: "enabled: false"; color: Palette.foreground.transparentize(0.45); vertical-alignment: center; }
                        TextEdit { width: 280px * ForgeTypography.scale; height: 56px * ForgeTypography.scale; text: "192.168.1.20:8080"; read-only: true; enabled: false; }
                    }
                }
            }
        }

        scenario := GalleryExample {
            title: @tr("错误报告");
            description: @tr("出错时展示可复制的错误详情，用户一键复制后粘贴到反馈渠道。");
            output: root.report-status;
            GalleryPreview {
                Rectangle {
                    width: 440px * ForgeTypography.scale;
                    height: report.preferred-height;
                    border-radius: 8px; border-width: 1px; border-color: Palette.border;
                    background: Palette.background;
                    report := VerticalLayout {
                        padding: 20px; spacing: 12px;
                        Text { text: @tr("同步失败"); color: #c42b1c; font-size: 15px * ForgeTypography.scale; font-weight: 600; }
                        Text { text: @tr("无法连接到服务器。复制下方详情并发送给技术支持。"); color: Palette.foreground.transparentize(0.3); font-size: 14px * ForgeTypography.scale; wrap: word-wrap; }
                        details := TextEdit {
                            height: 90px * ForgeTypography.scale; read-only: true;
                            font-family: "Consolas"; font-size: 12px * ForgeTypography.scale;
                            text: "ErrorCode: SYNC_TIMEOUT (0x80072EE2)\nEndpoint: https://sync.example.com/v2/push\nTime: 2026-10-25 14:32:07 UTC+8\nClient: SlintForge Gallery 0.0.1";
                        }
                        HorizontalLayout {
                            spacing: 8px; alignment: end;
                            Button { text: @tr("重试"); clicked => { root.report-status = @tr("正在重试…"); } }
                            Button {
                                text: @tr("复制错误详情"); primary: true;
                                clicked => { details.select-all(); details.copy(); root.report-status = @tr("错误详情已复制到剪贴板"); }
                            }
                        }
                    }
                }
            }
        }
    }
}
