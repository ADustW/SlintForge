import { TextEdit, ComboBox } from "std-widgets.slint";
import { ForgeSyntaxView, ForgeTypography } from "@slintforge";
import { GallerySamplePage } from "../component/sample-page.slint";
import { GalleryDemoModels } from "../component/demo-models.slint";

// 共享组件演示：SyntaxView。
export component GalleryOtherSyntaxPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    callback prepare-preview(bool);
    prepare-preview(open) => {  }
    in-out property<string> code-language: "slint";
in-out property<string> code-text: "export component Example inherits Window {\n    width: 420px; // 共享 Slint 界面\n    Text { text: \"Hello\"; }\n}";
    sample := GallerySamplePage {
        title: "SyntaxView";
        subtitle: @tr("编辑文本，切换语言并查看高亮结果。");
        example-title: @tr("用法与状态");
        preview-height: 570px * ForgeTypography.scale;
        VerticalLayout {
            x: 20px; y: 20px; width: Math.max(0px, Math.min(620px, sample.preview-width - 40px));
            height: Math.max(0px, sample.preview-area-height - 40px);
            spacing: 16px; alignment: start;
            ComboBox { model: ["slint", "rust", "cpp", "python", "json"]; selected(value) => { root.code-language = value; } }
TextEdit { height: 100px; text <=> root.code-text; font-family: "Consolas"; }
ForgeSyntaxView { height: 260px; code: root.code-text; language: root.code-language; }
        }
    }
    
}
