import { CheckBox, LineEdit, Palette } from "std-widgets.slint";
import { ForgePillButton, ForgeTypography } from "@slintforge";
import { GalleryComponentPage, GalleryExample, GalleryPreview, GalleryOptions, GalleryVariant } from "../component/component-page.slint";

// 共享组件演示：PillButton。
export component GalleryInputsPillButtonPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: false;
    in-out property<float> number: 30;
    in-out property<string> draft: @tr("胶囊按钮");
    in-out property<string> status: @tr("尚未选择操作");
    private property<bool> disabled: false;
    callback prepare-preview(bool);
    prepare-preview(open) => {  }

    GalleryComponentPage {
        width: parent.width; height: parent.height;
        category: @tr("输入 / 按钮");
        title: "PillButton";
        subtitle: @tr("两端为半圆的胶囊形按钮，适合工具栏、筛选条和对话框中的次要操作。");
        showcase-route: "inputs-pill-button";
        qa-anchors: [states.y, scenario.y];
        api: [
            { name: "text", kind: @tr("属性"), type: "string", description: @tr("按钮文字。") },
            { name: "primary", kind: @tr("属性"), type: "bool", description: @tr("使用主色填充，用于主要操作。") },
            { name: "enabled", kind: @tr("属性"), type: "bool", description: @tr("禁用后不响应鼠标与键盘。") },
            { name: "pressed / has-focus", kind: @tr("输出"), type: "bool", description: @tr("按下与焦点状态。") },
            { name: "clicked()", kind: @tr("回调"), type: "", description: @tr("鼠标单击，或聚焦时按 Enter / Space 触发。") },
            { name: "focus-button()", kind: @tr("函数"), type: "", description: @tr("把键盘焦点移到按钮上。") },
        ];

        GalleryExample {
            title: @tr("基本用法");
            description: @tr("在右侧修改文字和属性，预览即时更新。");
            output: @tr("clicked · 已点击 {} 次", root.count);
            GalleryPreview {
                ForgePillButton { text: root.draft; primary: root.flag; enabled: !root.disabled; clicked => { root.count += 1; } }
            }
            GalleryOptions {
                CheckBox { text: "primary"; checked <=> root.flag; }
                CheckBox { text: @tr("禁用"); checked <=> root.disabled; }
                Text { text: "text"; color: Palette.foreground.transparentize(0.45); font-size: 12px * ForgeTypography.scale; }
                LineEdit { text <=> root.draft; }
            }
        }

        states := GalleryExample {
            title: @tr("状态对照");
            description: @tr("默认、主色与禁用三种状态并排比较。");
            GalleryPreview {
                content-padding: 16px;
                GalleryVariant { caption: @tr("默认"); ForgePillButton { text: @tr("取消"); } }
                GalleryVariant { caption: "primary: true"; ForgePillButton { text: @tr("确认"); primary: true; } }
                GalleryVariant { caption: "enabled: false"; ForgePillButton { text: @tr("不可用"); enabled: false; } }
            }
        }

        scenario := GalleryExample {
            title: @tr("对话框操作栏");
            description: @tr("主要操作使用 primary，其余操作保持默认样式并靠右排列。");
            output: root.status;
            GalleryPreview {
                Rectangle {
                    width: 420px * ForgeTypography.scale;
                    height: dialog.preferred-height;
                    border-radius: 8px; border-width: 1px; border-color: Palette.border;
                    background: Palette.background;
                    dialog := VerticalLayout {
                        padding: 20px; spacing: 16px;
                        Text { text: @tr("保存对“季度报告”的更改？"); color: Palette.foreground; font-size: 15px * ForgeTypography.scale; font-weight: 600; wrap: word-wrap; }
                        Text { text: @tr("不保存，所做的更改将会丢失。"); color: Palette.foreground.transparentize(0.3); font-size: 13px * ForgeTypography.scale; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px; alignment: end;
                            ForgePillButton { text: @tr("不保存"); clicked => { root.status = @tr("已放弃更改"); } }
                            ForgePillButton { text: @tr("取消"); clicked => { root.status = @tr("已取消"); } }
                            ForgePillButton { text: @tr("保存"); primary: true; clicked => { root.status = @tr("已保存"); } }
                        }
                    }
                }
            }
        }
    }
}
