import { ForgeCalendarPicker } from "@slintforge";
import { ForgeTypography } from "@slintforge";
import { Palette } from "std-widgets.slint";
import { GalleryPageFrame } from "../component/page-frame.slint";
import { GalleryPickerExample } from "../component/picker-example.slint";

export component GalleryFormCalendarPickerPage inherits Rectangle {
    in property<string> language: "zh";
    private property<bool> preview-with-time: false;
    callback configure-preview(bool);
    configure-preview(with-time) => { root.preview-with-time = with-time; }
    callback prepare-preview(bool);
    prepare-preview(open) => { if open { if root.preview-with-time { second.open(); } else { first.open(); } } else { first.close(); second.close(); } }
    GalleryPageFrame {
        width: root.width; height: root.height;
        background: Palette.color-scheme == ColorScheme.dark ? #282828 : Palette.background;
        title: @tr("日历选择器"); content-spacing: 20px * ForgeTypography.scale;
        sample1 := GalleryPickerExample { label: @tr("日期"); preview-height: 70px * ForgeTypography.scale; first := ForgeCalendarPicker { x: 0px; y: 0px; language: root.language; dark: sample1.dark; enabled: !sample1.disabled; } }
        sample2 := GalleryPickerExample { label: @tr("日期与时间"); preview-height: 70px * ForgeTypography.scale; second := ForgeCalendarPicker { x: 0px; y: 0px; language: root.language; dark: sample2.dark; enabled: !sample2.disabled; show-time: true; } }
    }
}
