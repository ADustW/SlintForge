import { Button, CheckBox, ComboBox, LineEdit, Palette, SpinBox, Switch } from "std-widgets.slint";
import { ForgeDrawer, ForgeDrawerEdge, ForgePillButton, ForgeTypography } from "@slintforge";
import { GalleryComponentPage, GalleryExample, GalleryPreview, GalleryOptions, GalleryVariant } from "../component/component-page.slint";

// 共享组件演示：Drawer。
export component GalleryPopupsDrawerPage inherits Rectangle {
    in-out property<int> count: 0;
    in-out property<bool> flag: true;
    in-out property<float> number: 30;
    in-out property<string> draft;
    in-out property<string> status: @tr("就绪");
    callback prepare-preview(bool);
    prepare-preview(open) => { root.drawer-open = open; }
    in-out property<bool> drawer-open: false;
    private property<int> edge-index: 1;
    private property<int> panel-width: 360;
    private property<bool> dismiss-outside: true;
    // 场景：筛选抽屉。
    private property<bool> filter-open: false;
    private property<bool> unread-only: false;
    private property<bool> include-archived: false;
    private property<int> sort-index: 0;
    private property<string> filter-status: @tr("全部邮件，按时间排序");

    GalleryComponentPage {
        width: parent.width; height: parent.height;
        category: @tr("弹出层");
        title: "Drawer";
        subtitle: @tr("从页面左侧或右侧滑出的面板，带半透明遮罩，适合放置设置、筛选或详情等次要内容。关闭后面板内的输入会保留。");
        api: [
            { name: "open", kind: @tr("属性"), type: "bool", description: @tr("是否显示，可双向绑定。") },
            { name: "title", kind: @tr("属性"), type: "string", description: @tr("面板标题，右侧带关闭按钮。") },
            { name: "edge", kind: @tr("属性"), type: "ForgeDrawerEdge", description: @tr("滑出方向：left 或 right，默认 right。") },
            { name: "panel-width", kind: @tr("属性"), type: "length", description: @tr("面板宽度，不超过页面宽度，默认 360px。") },
            { name: "dismiss-on-outside", kind: @tr("属性"), type: "bool", description: @tr("点击遮罩是否关闭，默认 true。") },
            { name: "dismissed()", kind: @tr("回调"), type: "", description: @tr("通过关闭按钮、Esc 或遮罩关闭时触发。") },
            { name: "dismiss()", kind: @tr("函数"), type: "", description: @tr("以编程方式关闭并触发 dismissed。") },
        ];

        GalleryExample {
            title: @tr("基本用法");
            description: @tr("打开抽屉，在面板中输入后关闭再打开，内容仍然保留。");
            output: root.status;
            GalleryPreview {
                Button { text: @tr("打开抽屉"); primary: true; clicked => { root.drawer-open = true; } }
            }
            GalleryOptions {
                Text { text: "edge"; color: Palette.foreground.transparentize(0.45); font-size: 12px * ForgeTypography.scale; }
                ComboBox { model: ["left", "right"]; current-index <=> root.edge-index; }
                Text { text: "panel-width"; color: Palette.foreground.transparentize(0.45); font-size: 12px * ForgeTypography.scale; }
                SpinBox { minimum: 200; maximum: 600; step-size: 20; value <=> root.panel-width; }
                CheckBox { text: "dismiss-on-outside"; checked <=> root.dismiss-outside; }
            }
        }

        GalleryExample {
            title: @tr("状态对照");
            description: @tr("右侧与左侧滑出的面板，在缩小的区域中预览。");
            GalleryPreview {
                content-padding: 16px;
                GalleryVariant {
                    caption: "edge: right";
                    Rectangle {
                        min-width: 180px; preferred-width: 260px * ForgeTypography.scale; height: 170px * ForgeTypography.scale;
                        clip: true;
                        Text { text: @tr("页面内容"); color: Palette.foreground.transparentize(0.45); }
                        ForgeDrawer {
                            open: true; title: @tr("详情"); panel-width: 150px; edge: ForgeDrawerEdge.right;
                            dismissed => { self.open = true; }
                        }
                    }
                }
                GalleryVariant {
                    caption: "edge: left";
                    Rectangle {
                        min-width: 180px; preferred-width: 260px * ForgeTypography.scale; height: 170px * ForgeTypography.scale;
                        clip: true;
                        Text { text: @tr("页面内容"); color: Palette.foreground.transparentize(0.45); }
                        ForgeDrawer {
                            open: true; title: @tr("目录"); panel-width: 150px; edge: ForgeDrawerEdge.left;
                            dismissed => { self.open = true; }
                        }
                    }
                }
            }
        }

        GalleryExample {
            title: @tr("邮件筛选");
            description: @tr("筛选条件放在抽屉中，点击“应用”后关闭抽屉并更新列表条件。");
            output: root.filter-status;
            GalleryPreview {
                Rectangle {
                    width: 360px * ForgeTypography.scale;
                    height: inbox.preferred-height;
                    border-radius: 8px; border-width: 1px; border-color: Palette.border;
                    background: Palette.background;
                    inbox := VerticalLayout {
                        padding: 16px; spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: @tr("收件箱"); color: Palette.foreground; font-size: 15px * ForgeTypography.scale; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            ForgePillButton { text: @tr("筛选"); clicked => { root.filter-open = true; } }
                        }
                        Text { text: root.filter-status; color: Palette.foreground.transparentize(0.4); font-size: 12px * ForgeTypography.scale; wrap: word-wrap; }
                    }
                }
            }
        }
    }

    // 抽屉覆盖整个页面区域，不随示例内容滚动。
    ForgeDrawer {
        open <=> root.drawer-open; title: @tr("抽屉设置");
        edge: root.edge-index == 0 ? ForgeDrawerEdge.left : ForgeDrawerEdge.right;
        panel-width: root.panel-width * 1px;
        dismiss-on-outside: root.dismiss-outside;
        dismissed => { root.status = @tr("抽屉已关闭"); }
        VerticalLayout { spacing: 14px; alignment: start; LineEdit { placeholder-text: @tr("输入会保留"); } Switch { text: @tr("启用功能"); } }
    }

    ForgeDrawer {
        open <=> root.filter-open; title: @tr("筛选邮件"); panel-width: 320px;
        VerticalLayout {
            spacing: 14px; alignment: start;
            CheckBox { text: @tr("仅看未读"); checked <=> root.unread-only; }
            CheckBox { text: @tr("包含已归档"); checked <=> root.include-archived; }
            Text { text: @tr("排序"); color: Palette.foreground.transparentize(0.45); font-size: 12px * ForgeTypography.scale; }
            ComboBox { model: [@tr("按时间"), @tr("按发件人"), @tr("按大小")]; current-index <=> root.sort-index; }
            HorizontalLayout {
                alignment: end;
                ForgePillButton {
                    text: @tr("应用"); primary: true;
                    clicked => {
                        root.filter-status = @tr("{}{}，{}", root.unread-only ? @tr("仅未读邮件") : @tr("全部邮件"), root.include-archived ? @tr("（含归档）") : "", root.sort-index == 1 ? @tr("按发件人排序") : root.sort-index == 2 ? @tr("按大小排序") : @tr("按时间排序"));
                        root.filter-open = false;
                    }
                }
            }
        }
    }
}
