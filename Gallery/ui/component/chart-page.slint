import { Palette, Button, CheckBox } from "std-widgets.slint";
import { ForgeChart, ForgeChartKind, ForgeChartSeries, ForgeChartSlice, ForgeTypography } from "@slintforge";
import { GalleryComponentPage, GalleryExample, GalleryPreview, GalleryOptions, GalleryVariant } from "component-page.slint";

// 七类图表共享演示框架；切换数据、图例和选项均操作实际组件。
export component GalleryChartPage inherits Rectangle {
    in property<string> title;
    in property<ForgeChartKind> kind;
    property<string> showcase-route: root.kind == bar ? "chart-bar" : root.kind == line ? "chart-line" : root.kind == pie ? "chart-pie" : root.kind == polar ? "chart-polar" : root.kind == bubble ? "chart-bubble" : root.kind == scatter ? "chart-scatter" : "chart-radar";
    in-out property<bool> updated: false;
    in-out property<bool> empty: false;
    in-out property<bool> stacked: false;
    in-out property<bool> smooth: false;
    in-out property<bool> filled: true;
    in-out property<bool> doughnut: false;
    in-out property<string> selection: @tr("悬停查看数值，点击选择数据，点击图例显示或隐藏系列。");
    property<[string]> categories: root.kind == radar
        ? [@tr("饮食"), @tr("饮水"), @tr("睡眠"), @tr("设计"), @tr("编程"), @tr("骑行"), @tr("跑步")]
        : [@tr("一月"), @tr("二月"), @tr("三月"), @tr("四月"), @tr("五月"), @tr("六月"), @tr("七月")];
    property<[ForgeChartSeries]> series: [
        { name: @tr("系列一"), color: #36a2eb, points: [
            {x: 0, y: root.updated ? 38 : 65, size: 12}, {x: 1, y: root.updated ? 74 : 59, size: 20},
            {x: 2, y: 80, size: 9}, {x: 3, y: root.updated ? 48 : 81, size: 24},
            {x: 4, y: 56, size: 15}, {x: 5, y: root.updated ? 68 : 55, size: 10}, {x: 6, y: 40, size: 18}
        ] },
        { name: @tr("系列二"), color: #ff6384, points: [
            {x: 0, y: 28, size: 18}, {x: 1, y: 48, size: 12}, {x: 2, y: root.updated ? 70 : 40, size: 22},
            {x: 3, y: 19, size: 8}, {x: 4, y: root.updated ? 48 : 96, size: 16},
            {x: 5, y: 27, size: 13}, {x: 6, y: 100, size: 20}
        ] }
    ];
    property<[ForgeChartSlice]> slices: [
        {label: @tr("红色"), value: root.updated ? 22 : 11, color: #ff6384},
        {label: @tr("绿色"), value: root.updated ? 9 : 16, color: #4bc0c0},
        {label: @tr("黄色"), value: 7, color: #ffcd56},
        {label: @tr("灰色"), value: root.updated ? 12 : 3, color: #788694},
        {label: @tr("蓝色"), value: 14, color: #36a2eb}
    ];
    property<string> style-caption: root.kind == bar ? "stacked: true" : root.kind == line ? "smooth · fill-area" : root.kind == pie ? "doughnut: true" : root.kind == polar ? @tr("三个扇区") : @tr("单系列");
    callback prepare-preview(bool);
    prepare-preview(open) => {
        root.stacked = open && root.kind == bar;
        root.smooth = open && root.kind == line;
        root.doughnut = open && root.kind == pie;
        if open { chart.select-point(0); } else { chart.clear-selection(); }
    }
    GalleryComponentPage {
        width: parent.width; height: parent.height;
        category: @tr("图表");
        title: root.title;
        subtitle: root.kind == bar ? @tr("比较各月份的数据，切换分组或堆叠。")
            : root.kind == line ? @tr("观察趋势，切换折线、平滑曲线和面积填充。")
            : root.kind == pie ? @tr("比较各类别占比，切换饼图或环形图。")
            : root.kind == polar ? @tr("扇区角度相同，面积随类别数值变化。")
            : root.kind == bubble ? @tr("位置表示两个数值，圆的大小表示第三个数值。")
            : root.kind == scatter ? @tr("查看两个系列的分布和相关性。")
            : @tr("对比多个维度上的系列表现。");
        showcase-route: root.showcase-route;
        qa-anchors: [styles.y, boundary.y];
        api: [
            { name: "kind", kind: @tr("属性"), type: "ForgeChartKind", description: @tr("bar、line、pie、polar、bubble、scatter 或 radar。") },
            { name: "series / slices", kind: @tr("属性"), type: "[ForgeChartSeries] / [ForgeChartSlice]", description: @tr("坐标类图表用 series，饼图与极坐标图用 slices。") },
            { name: "categories", kind: @tr("属性"), type: "[string]", description: @tr("类别轴或雷达图维度的标签。") },
            { name: "stacked / smooth / fill-area / doughnut", kind: @tr("属性"), type: "bool", description: @tr("堆叠、平滑、面积填充与环形样式。") },
            { name: "show-legend / show-grid", kind: @tr("属性"), type: "bool", description: @tr("显示图例与网格线。") },
            { name: "point-selected(int, int, float)", kind: @tr("回调"), type: "", description: @tr("点击数据点，参数为系列、索引与数值。") },
            { name: "select-point / clear-selection", kind: @tr("函数"), type: "", description: @tr("以编程方式选择或清除数据点。") },
        ];

        GalleryExample {
            title: @tr("交互示例");
            description: @tr("悬停读取数值，点击数据点或图例进行交互；在右侧更新数据或切换样式。");
            output: root.selection;
            GalleryPreview {
                stretch: true;
                content-padding: 16px;
                chart := ForgeChart {
                    height: 370px * ForgeTypography.scale;
                    horizontal-stretch: 1;
                    kind: root.kind;
                    series: root.empty ? [] : root.series;
                    slices: root.empty ? [] : root.slices;
                    categories: root.categories;
                    include-zero: true;
                    stacked: root.stacked; smooth: root.smooth;
                    fill-area: root.filled; doughnut: root.doughnut;
                    point-selected(series, point, value) => {
                        root.selection = @tr("已选择：系列 {}，数据 {}，值 {}", series + 1, point + 1, value);
                    }
                }
            }
            GalleryOptions {
                Button { text: root.updated ? @tr("恢复数据") : @tr("更新数据"); clicked => { root.updated = !root.updated; root.empty = false; } }
                Button { text: root.empty ? @tr("显示数据") : @tr("清空数据"); clicked => { root.empty = !root.empty; } }
                if root.kind == bar : CheckBox { text: "stacked"; checked <=> root.stacked; }
                if root.kind == line : CheckBox { text: "smooth"; checked <=> root.smooth; }
                if root.kind == line || root.kind == radar : CheckBox { text: "fill-area"; checked <=> root.filled; }
                if root.kind == pie : CheckBox { text: "doughnut"; checked <=> root.doughnut; }
            }
        }

        styles := GalleryExample {
            title: @tr("样式对照");
            description: @tr("同一组数据的基础样式与变体样式。");
            GalleryPreview {
                stretch: true;
                content-padding: 16px;
                GalleryVariant {
                    caption: @tr("基础样式");
                    ForgeChart { height: 300px * ForgeTypography.scale; horizontal-stretch: 1; kind: root.kind; series: root.series; slices: root.slices; categories: root.categories; }
                }
                GalleryVariant {
                    caption: root.style-caption;
                    ForgeChart {
                        height: 300px * ForgeTypography.scale; horizontal-stretch: 1; kind: root.kind;
                        series: root.kind == bubble || root.kind == scatter || root.kind == radar ? [root.series[1]] : root.series;
                        slices: root.kind == polar ? [root.slices[0], root.slices[1], root.slices[2]] : root.slices;
                        categories: root.categories; stacked: true; smooth: true; fill-area: true; doughnut: true;
                    }
                }
            }
        }

        boundary := GalleryExample {
            title: @tr("数据与空状态");
            description: @tr("少量数据，以及清空数据后保留容器与空状态提示。");
            GalleryPreview {
                stretch: true;
                content-padding: 16px;
                GalleryVariant {
                    caption: @tr("单系列数据");
                    ForgeChart { height: 300px * ForgeTypography.scale; horizontal-stretch: 1; kind: root.kind; series: [root.series[0]]; slices: [root.slices[0], root.slices[1]]; categories: root.categories; }
                }
                GalleryVariant {
                    caption: @tr("暂无数据");
                    ForgeChart { height: 300px * ForgeTypography.scale; horizontal-stretch: 1; kind: root.kind; series: []; slices: []; categories: root.categories; }
                }
            }
        }
    }
}
