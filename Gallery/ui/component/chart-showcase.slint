import { Palette, TabWidget } from "std-widgets.slint";
import { ForgeChart, ForgeChartKind, ForgeChartSeries, ForgeChartSlice, ForgeTypography } from "@slintforge";
import { GalleryEffectCard, GalleryShowcaseState } from "showcase.slint";

export component GalleryChartShowcase inherits Rectangle {
    in property<string> route;
    in property<ForgeChartKind> kind;
    in property<[string]> categories;
    in property<[ForgeChartSeries]> series;
    in property<[ForgeChartSlice]> slices;
    property<int> columns: root.width >= 840px ? 2 : 1;
    preferred-height: (400px * ForgeTypography.scale + 16px) * (2 / root.columns) + 60px;
    height: root.preferred-height; vertical-stretch: 0;
    tabs := TabWidget {
        width: root.width; height: root.height;
        current-index: GalleryShowcaseState.route == root.route && GalleryShowcaseState.tab >= 0 ? GalleryShowcaseState.tab : 0;
        Tab {
            title: @tr("样式对照");
            for index in 2 : style-card := GalleryEffectCard {
                x: mod(index, root.columns) * (parent.width / root.columns);
                y: floor(index / root.columns) * (400px * ForgeTypography.scale + 16px) + 12px;
                width: parent.width / root.columns - 12px; height: 400px * ForgeTypography.scale;
                title: index == 0 ? @tr("基础样式") : root.kind == bar ? @tr("堆叠柱状图") : root.kind == line ? @tr("平滑面积图") : root.kind == pie ? @tr("环形图") : @tr("系列对照");
                description: @tr("悬停读取数值，点击数据或图例进行交互。");
                ForgeChart { x: 16px; y: style-card.body-y; width: style-card.body-width; height: style-card.body-height; kind: root.kind; series: index == 1 && (root.kind == bubble || root.kind == scatter || root.kind == radar) ? [root.series[1]] : root.series; slices: index == 1 && root.kind == polar ? [root.slices[0],root.slices[1],root.slices[2]] : root.slices; categories: root.categories; stacked: index == 1 && root.kind == bar; smooth: index == 1; fill-area: index == 1; doughnut: index == 1; }
            }
        }
        Tab {
            title: @tr("数据与空状态");
            for index in 2 : boundary-card := GalleryEffectCard {
                x: mod(index, root.columns) * (parent.width / root.columns);
                y: floor(index / root.columns) * (400px * ForgeTypography.scale + 16px) + 12px;
                width: parent.width / root.columns - 12px; height: 400px * ForgeTypography.scale;
                title: index == 0 ? @tr("单系列数据") : @tr("暂无数据");
                description: index == 0 ? @tr("查看简化后的数据分布。") : @tr("清空数据后保留容器与空状态提示。");
                ForgeChart { x: 16px; y: boundary-card.body-y; width: boundary-card.body-width; height: boundary-card.body-height; kind: root.kind; series: index == 0 ? [root.series[0]] : []; slices: index == 0 ? [root.slices[0],root.slices[1]] : []; categories: root.categories; }
            }
        }
    }
}
