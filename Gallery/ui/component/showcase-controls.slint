import { Button, CheckBox, RadioGroup, Switch, Slider, SpinBox, ComboBox, LineEdit, TextEdit, ProgressIndicator, Spinner,
    Palette, Date, Time } from "std-widgets.slint";
import { ForgePillButton, ForgeDelayButton, ForgeProgressButton, ForgeDropDownButton, ForgeInputValidation,
    ForgeChip, ForgeTagInputBox, ForgeAutoSuggestBox, ForgeNumberBox, ForgeColorPicker, ForgeShortcutPicker,
    ForgeMultiSelectComboBox, ForgeMultiTreeSelectComboBox, ForgeChoiceItem, ForgeInfoBadge, ForgeResult,
    ForgeRatingControl, ForgeShimmer, ForgeSkeletonView, ForgeStatistic, ForgeTimeline, ForgeQRCode,
    ForgeSegmentedControl, ForgePagination, ForgeTypography, ForgeDateTime, ForgeDatePickerPopup, ForgeTimePickerPopup } from "@slintforge";
import { GalleryDemoModels } from "demo-models.slint";
import { GalleryLocale } from "locale.slint";

// 输入和选择状态由卡片持有；标签和树继续使用宿主提供的模型。
export component GalleryShowcaseControl inherits Rectangle {
    in property<string> route;
    in property<int> variant: 0;
    in property<bool> interactive: true;
    in property<bool> animation-visible: true;
    in property<bool> business: false;
    in-out property<bool> checked: root.variant == 1;
    in-out property<float> value: root.variant == 0 ? 25 : root.variant == 1 ? 75 : 100;
    in-out property<string> draft: root.variant == 0 ? "" : root.variant == 1 ? "SlintForge" : @tr("禁用示例");
    in-out property<string> message: root.interactive ? @tr("可直接操作此示例") : @tr("禁用示例");
    in-out property<int> clicks: 0;
    in-out property<string> choice: "a";
    in-out property<Date> date: {year: 2026, month: 10, day: root.variant == 0 ? 5 : 18};
    in-out property<Time> time: {hour: root.variant == 0 ? 9 : 18, minute: 30, second: 0};
    in-out property<[ForgeChoiceItem]> choices: [
        {id: "a", label: @tr("采集"), enabled: true, selected: root.variant == 1},
        {id: "b", label: @tr("分析"), enabled: true, selected: root.variant == 1},
        {id: "c", label: @tr("归档"), enabled: false}
    ];
    out property<string> summary: root.message + " · " + root.clicks;
    public function acted() { root.clicks += 1; root.message = @tr("操作已完成"); }
    VerticalLayout {
        spacing: 12px; alignment: start;
        if root.route == "inputs-standard-button" || root.route == "inputs-filled-button" : Button {
            text: root.business ? @tr("保存项目") : root.variant == 1 ? @tr("主要操作") : @tr("普通操作");
            primary: root.route == "inputs-filled-button" || root.variant == 1;
            enabled: root.interactive; clicked => { root.acted(); }
        }
        if root.route == "inputs-hyperlink-button" : StyledText {
            text: root.variant == 1 ? @markdown("[项目文档](https://slint.dev)") : @markdown("[Slint 官方网站](https://slint.dev)");
            default-color: Palette.foreground;
            link-clicked(url) => { if root.interactive { Platform.open-url(url); } }
        }
        if root.route == "inputs-pill-button" : ForgePillButton {
            text: root.business ? @tr("创建工程") : @tr("胶囊按钮"); primary: root.variant == 1;
            enabled: root.interactive; clicked => { root.acted(); }
        }
        if root.route == "inputs-delay-button" : ForgeDelayButton {
            text: root.variant == 1 ? @tr("按住 2 秒") : @tr("按住 1 秒");
            delay: root.variant == 1 ? 2000ms : 1000ms; enabled: root.interactive; clicked => { root.acted(); }
        }
        if root.route == "inputs-progress-button" : ForgeProgressButton {
            text: @tr("上传报告"); busy: root.variant == 1 || root.checked;
            progress: root.variant == 1 ? 0.65 : -1; enabled: root.interactive;
            clicked => { root.checked = true; root.acted(); }
        }
        if root.route == "inputs-dropdown-button" : ForgeDropDownButton {
            text: @tr("导出报告"); items: [{id:"pdf",label:"PDF",enabled:true}, {id:"csv",label:"CSV",enabled:true}, {id:"xlsx",label:"Excel",enabled:false}];
            enabled: root.interactive; selected(id) => { root.message = id; root.clicks += 1; }
        }
        if root.route == "inputs-toggle-button" : Button {
            text: root.checked ? @tr("已固定") : @tr("固定视图"); checkable: true; checked <=> root.checked;
            enabled: root.interactive;
        }
        if root.route == "inputs-radio-button" : RadioGroup {
            RadioButton { text: @tr("连续采集"); checked: root.variant == 0; enabled: root.interactive; }
            RadioButton { text: @tr("触发采集"); checked: root.variant == 1; enabled: root.interactive; }
            selected(value) => { root.message = value; }
        }
        if root.route == "inputs-checkbox" : CheckBox {
            text: root.business ? @tr("启用自动归档") : @tr("选择此项"); checked <=> root.checked; enabled: root.interactive;
        }
        if root.route == "inputs-toggle-switch" : Switch { text: @tr("自动保存"); checked <=> root.checked; enabled: root.interactive; }
        if root.route == "inputs-slider" : VerticalLayout {
            spacing: 12px;
            Slider { minimum: 0; maximum: 100; value <=> root.value; enabled: root.interactive; }
            Text { text: @tr("增益 {}%", round(root.value)); color: Palette.foreground; }
        }
        if root.route == "inputs-chip" : ForgeChip {
            text: root.variant == 1 ? @tr("已选择") : "SlintForge"; selected <=> root.checked; enabled: root.interactive;
            removable: root.variant != 1; removed => { root.message = @tr("已移除，可重新选择"); }
        }
        if root.route == "inputs-tag-input" : ForgeTagInputBox {
            tags: GalleryDemoModels.tags; enabled: root.interactive; maximum-tags: root.variant == 1 ? 3 : 20;
            add-requested(text) => { GalleryDemoModels.add-tag(text); }
            remove-requested(index) => { GalleryDemoModels.remove-tag(index); }
        }
        if root.route == "inputs-copyable-text" || root.route == "data-selection" : TextEdit {
            text: @tr("SlintForge 项目报告\n可以选择、复制文本；业务场景可编辑。\nRust 与 C++ 使用共享界面。");
            read-only: !root.business; enabled: root.interactive; height: 150px;
        }
        if root.route == "inputs-validation" : ForgeInputValidation {
            text: root.variant == 1 ? "S" : root.draft; placeholder-text: @tr("输入 3～24 个字符");
            minimum-length: 3; maximum-length: 24; touched: true; enabled: root.interactive;
            edited(text) => { root.message = text; }
        }
        if root.route == "form-textbox" : LineEdit {
            text <=> root.draft; placeholder-text: @tr("项目名称"); read-only: root.variant == 1; enabled: root.interactive;
        }
        if root.route == "form-password-box" : VerticalLayout {
            spacing: 12px;
            LineEdit { text: "SlintForge2026"; input-type: root.checked ? InputType.text : InputType.password; enabled: root.interactive; }
            CheckBox { text: @tr("显示密码"); checked <=> root.checked; enabled: root.interactive; }
        }
        if root.route == "form-multiline-textbox" || root.route == "form-scrollable-textbox" : TextEdit {
            height: 180px; enabled: root.interactive; read-only: root.variant == 1;
            text: @tr("项目说明\n通道 1：电压采集\n通道 2：温度监测\n采样频率：100 Hz\n触发模式：连续\n存储格式：CSV\n记录开始\n记录结束\n继续滚动查看完整内容\n备注：支持中文输入");
        }
        if root.route == "form-combo-box" : ComboBox {
            model: [@tr("电压"), @tr("温度"), @tr("电流")]; current-index: root.variant == 1 ? 1 : 0; enabled: root.interactive;
            selected(text) => { root.message = text; }
        }
        if root.route == "form-spin-box" : SpinBox { minimum: 1; maximum: 100; value: round(root.value); enabled: root.interactive; }
        if root.route == "form-number-box" : ForgeNumberBox { minimum: -10; maximum: 10; step: root.variant == 1 ? 0.5 : 0.1; value: root.variant == 1 ? 9.5 : 2.5; enabled: root.interactive; }
        if root.route == "form-auto-suggest" : VerticalLayout {
            spacing: 12px;
            ForgeAutoSuggestBox {
                text: root.variant == 1 ? "zzz" : root.draft; placeholder-text: @tr("搜索设备或组件");
                suggestions: ["Slint", "SlintForge", "Slider", "Sensor A", "Sensor B", "Rust", "C++"];
                open: !root.business && root.variant != 2;
                enabled: root.interactive; selected(text) => { root.message = text; root.clicks += 1; }
            }
            Text { text: @tr("↑ ↓ 导航 · Enter 选择 · Esc 关闭"); color: Palette.foreground; wrap: word-wrap; }
        }
        if root.route == "form-multi-select-combo" : ForgeMultiSelectComboBox {
            items <=> root.choices; selection-text: root.variant == 1 ? @tr("采集、分析") : root.message;
            enabled: root.interactive; selection-changed(id, selected) => { root.message = id + (selected ? " +" : " -"); }
        }
        if root.route == "form-multi-tree-combo" : ForgeMultiTreeSelectComboBox {
            items: GalleryDemoModels.tree-items; selection-text: GalleryDemoModels.tree-selection; enabled: root.interactive;
            expansion-changed(id,value) => { GalleryDemoModels.expand-tree(id,value); }
            selection-changed(id,value) => { GalleryDemoModels.select-tree(id,value,true); }
        }
        if root.route == "form-shortcut-picker" : ForgeShortcutPicker { shortcut: root.variant == 1 ? "Ctrl+Shift+S" : "Ctrl+S"; enabled: root.interactive; }
        if root.route == "form-color-picker" : ForgeColorPicker { red: root.variant == 1 ? 255 : 54; green: root.variant == 1 ? 99 : 162; blue: root.variant == 1 ? 132 : 235; alpha: root.variant == 1 ? 128 : 255; enabled: root.interactive; }
        if root.route == "form-date-picker" || root.route == "form-calendar-picker" : VerticalLayout {
            spacing: 12px;
            Button { text: @tr("选择日期"); enabled: root.interactive; clicked => { date-picker.open(); } }
            Text { text: ForgeDateTime.format-date(root.date, GalleryLocale.language); color: Palette.foreground; wrap: word-wrap; }
        }
        if root.route == "form-time-picker" : VerticalLayout {
            spacing: 12px;
            Button { text: @tr("选择时间"); enabled: root.interactive; clicked => { time-picker.open(); } }
            Text { text: ForgeDateTime.format-time(root.time, GalleryLocale.language, time-picker.use-24-hour-format); color: Palette.foreground; wrap: word-wrap; }
        }
        if root.route == "feedback-progress-bar" : VerticalLayout {
            spacing: 12px;
            ProgressIndicator { progress: root.value / 100; indeterminate: root.variant == 0; }
            Text { text: root.variant == 0 ? @tr("正在连接…") : @tr("已完成 {}%", round(root.value)); color: Palette.foreground; }
        }
        if root.route == "feedback-progress-ring" : Spinner { width: 68px; height: 68px; progress: root.value / 100; indeterminate: root.variant == 0; }
        if root.route == "feedback-info-badge" : HorizontalLayout {
            spacing: 12px; alignment: start;
            Text { text: @tr("任务通知"); color: Palette.foreground; }
            ForgeInfoBadge { value: root.variant == 0 ? 8 : 128; dot: root.variant == 2; }
        }
        if root.route == "feedback-result" : ForgeResult {
            level: root.variant == 0 ? success : root.variant == 1 ? warning : error;
            title: root.variant == 0 ? @tr("报告已生成") : root.variant == 1 ? @tr("部分数据缺失") : @tr("连接失败");
            description: root.variant == 0 ? @tr("可继续查看或导出结果。") : @tr("请检查设备后重试。");
            action-text: root.variant == 0 ? @tr("查看报告") : @tr("重试"); action-requested => { root.acted(); }
        }
        if root.route == "feedback-rating" : ForgeRatingControl { value: root.variant == 0 ? 3 : 5; read-only: root.variant == 1; enabled: root.interactive; }
        if root.route == "feedback-shimmer" : VerticalLayout {
            spacing: 16px;
            ForgeShimmer { height: 24px; running: root.variant != 1 && root.animation-visible; }
            ForgeShimmer { width: parent.width * 0.65; height: 24px; running: root.variant != 1 && root.animation-visible; }
        }
        if root.route == "feedback-skeleton" : ForgeSkeletonView {
            height: 170px; rows: 2; loading: root.variant != 1; animate: root.animation-visible && root.variant == 0;
            Text { text: @tr("采集报告已加载\n电压：12.8 V\n温度：24.5 ℃"); color: Palette.foreground; wrap: word-wrap; }
        }
        if root.route == "data-statistic" : ForgeStatistic {
            title: root.variant == 0 ? @tr("本月完成") : root.variant == 1 ? @tr("待处理") : @tr("错误率");
            value: root.variant == 0 ? "1,280" : root.variant == 1 ? "32" : "0.8";
            suffix: root.variant == 2 ? "%" : @tr("项"); trend: root.variant == 1 ? -6.4 : 12.8;
        }
        if root.route == "data-timeline" : ForgeTimeline {
            items: [{title:@tr("创建任务"),time:"09:00",completed:true}, {title:@tr("采集数据"),time:"09:15",completed:root.variant != 0}, {title:@tr("生成报告"),time:"09:30",completed:root.variant == 1}];
        }
        if root.route == "data-qrcode" : ForgeQRCode { text: root.variant == 0 ? "SlintForge|2026" : root.variant == 1 ? "https://slint.dev" : "设备A|通道1"; width: 160px; height: 160px; }
        if root.route == "navigation-segmented" : ForgeSegmentedControl { items: root.choices; selected-id <=> root.choice; enabled: root.interactive; }
        if root.route == "navigation-pagination" : ForgePagination { total-items: root.variant == 0 ? 12 : 128; page-size: 10; enabled: root.interactive; }
        Rectangle { vertical-stretch: 1; }
        Text { visible: !root.business; height: root.business ? 0px : self.preferred-height; text: root.message + (root.clicks > 0 ? " · " + root.clicks : ""); color: Palette.foreground; font-size: 11px * ForgeTypography.scale; wrap: word-wrap; vertical-stretch: 0; }
    }
    date-picker := ForgeDatePickerPopup { y: 44px; language: GalleryLocale.language; date: root.date; title: @tr("选择日期"); accepted(value) => { root.date = value; } }
    time-picker := ForgeTimePickerPopup { y: 44px; language: GalleryLocale.language; time: root.time; use-24-hour-format: root.variant != 1; title: @tr("选择时间"); accepted(value) => { root.time = value; } }
}
