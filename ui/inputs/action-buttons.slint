import { Button, Palette, Spinner } from "std-widgets.slint";
import { ForgeTypography } from "../typography/typography.slint";
import { ForgeChoiceItem } from "../types/widgets.slint";
import { ForgeIcon, ForgeIcons } from "../icons/icon.slint";

export component ForgePillButton inherits Rectangle {
    in property<string> text;
    in property<bool> enabled: true;
    in property<bool> primary: false;
    out property<bool> pressed: touch.pressed || root.key-held;
    out property<bool> has-focus: focus.has-focus;
    private property<bool> key-held: false;
    callback clicked();
    public function focus-button() { focus.focus(); }
    min-width: label.preferred-width + 32px;
    preferred-height: Math.max(36px, label.preferred-height + 14px);
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: root.height / 2;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: !root.enabled ? Palette.border : focus.has-focus || root.primary ? Palette.accent-background : Palette.border;
    background: !root.enabled ? Palette.control-disabled : root.primary ? (root.pressed ? Palette.tertiary-accent-background : touch.has-hover ? Palette.secondary-accent-background : Palette.accent-background) : root.pressed ? Palette.control-tertiary : touch.has-hover ? Palette.control-secondary : Palette.control-background;

    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    label := Text {
        text: root.text; color: !root.enabled ? Palette.text-disabled : root.primary ? Palette.accent-foreground : root.pressed ? Palette.text-secondary : Palette.foreground;
        font-size: 14px * ForgeTypography.scale;
        horizontal-alignment: center; vertical-alignment: center;
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-lost(reason) => { root.key-held = false; }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.key-held = true; return accept; }
            return reject;
        }
        key-released(event) => {
            if event.text == Key.Return || event.text == " " {
                if root.key-held && root.enabled { root.clicked(); }
                root.key-held = false; return accept;
            }
            return reject;
        }
    }
    changed enabled => { if !root.enabled { root.key-held = false; } }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}

export enum ForgeDelayButtonMode { hold, hold-release, click }

// 三种确认方式共用内部填色；取消、失焦和禁用均清理未完成的确认。
export component ForgeDelayButton inherits Rectangle {
    in property<string> text: @tr("按住确认");
    in property<duration> delay: 1200ms;
    in property<bool> enabled: true;
    in property<ForgeDelayButtonMode> mode: hold-release;
    in property<bool> primary: false;
    in property<bool> pill: false;
    in property<bool> show-progress: true;
    out property<bool> running: root.active;
    out property<bool> pressed: touch.pressed || root.key-held;
    out property<bool> has-focus: focus.has-focus;
    out property<float> progress: !root.active ? 0 : root.delay <= 0ms ? 1 : min(1, root.elapsed / root.delay);
    private property<duration> elapsed: 0ms;
    private property<duration> started: 0ms;
    private property<bool> active: false;
    private property<bool> completed: false;
    private property<bool> key-held: false;
    callback clicked();
    callback canceled();
    public function focus-button() { focus.focus(); }
    public function cancel() {
        let pending = root.active && !root.completed;
        root.active = false; root.completed = false; root.elapsed = 0ms;
        if pending { root.canceled(); }
    }
    public function begin() {
        if !root.enabled { return; }
        if root.active { if root.mode == ForgeDelayButtonMode.click { root.cancel(); } return; }
        root.active = true; root.completed = false; root.elapsed = 0ms; root.started = animation-tick();
        if root.delay <= 0ms && root.mode != ForgeDelayButtonMode.hold-release { root.complete(); }
    }
    function complete() {
        if root.active && !root.completed && root.enabled {
            root.completed = true; root.clicked();
            if root.mode == ForgeDelayButtonMode.click { root.active = false; root.elapsed = 0ms; }
        }
    }
    public function finish() {
        if root.mode == ForgeDelayButtonMode.click { return; }
        if root.progress >= 1 { root.complete(); }
        root.cancel();
    }
    min-width: max(160px * ForgeTypography.scale, label.preferred-width + 32px);
    preferred-height: 32px * ForgeTypography.scale;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: root.pill ? root.height / 2 : 4px;
    background: !root.enabled ? Palette.control-disabled : root.primary ? Palette.accent-background : root.pressed ? Palette.control-tertiary : touch.has-hover ? Palette.control-secondary : Palette.control-background;

    clip: true;
    forward-focus: focus;
    accessible-role: button; accessible-label: root.text; accessible-enabled: root.enabled;
    accessible-action-default => { if root.mode == ForgeDelayButtonMode.click { root.begin(); } }
    Rectangle {
        x: 0px; y: 0px;
        width: root.width * root.progress; height: root.height;
        background: root.primary ? Palette.accent-foreground.with-alpha(0.25) : Palette.accent-background;
    }
    label := Text {
        text: root.text + (root.active && root.show-progress ? " · " + round(root.progress * 100) + "%" : "");
        color: !root.enabled ? Palette.text-disabled : root.primary ? Palette.accent-foreground : root.pressed ? Palette.text-secondary : Palette.foreground;
        font-size: 14px * ForgeTypography.scale; horizontal-alignment: center; vertical-alignment: center;
    }
    Rectangle {
        x: 0px; y: 0px; width: root.width * root.progress; height: root.height; clip: true;
        Text {
            x: 0px; y: 0px; width: root.width; height: root.height;
            text: label.text; color: Palette.accent-foreground;
            font-size: 14px * ForgeTypography.scale; horizontal-alignment: center; vertical-alignment: center;
        }
    }
    Rectangle {
        border-radius: root.border-radius; border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? Palette.accent-background : Palette.border; background: transparent;
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-lost(reason) => { root.key-held = false; root.cancel(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            if event.text == Key.Return || event.text == " " {
                if !root.key-held { root.key-held = true; root.begin(); } return accept;
            }
            return reject;
        }
        key-released(event) => {
            if event.text == Key.Return || event.text == " " {
                if root.key-held { root.finish(); } root.key-held = false; return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down { focus.focus(); root.begin(); }
                if event.kind == PointerEventKind.up {
                    if self.mouse-x >= 0px && self.mouse-x < root.width && self.mouse-y >= 0px && self.mouse-y < root.height { root.finish(); }
                    else { root.cancel(); }
                }
            }
            if event.kind == PointerEventKind.cancel { root.cancel(); }
        }
    }
    Timer {
        interval: 16ms; running: root.active && root.enabled && !root.completed && root.progress < 1;
        triggered => {
            root.elapsed = max(0ms, animation-tick() - root.started);
            if root.progress >= 1 && root.mode != ForgeDelayButtonMode.hold-release { root.complete(); }
        }
    }
    changed enabled => { if !root.enabled { root.key-held = false; root.cancel(); } }
    changed mode => { root.cancel(); }
}

export component ForgeProgressButton inherits Rectangle {
    in property<string> text: @tr("执行");
    in property<bool> busy: false;
    in property<bool> enabled: true;
    in property<float> progress: -1;
    callback clicked();
    min-width: layout.min-width; preferred-height: Math.max(36px, layout.preferred-height);
    horizontal-stretch: 0; vertical-stretch: 0;
    layout := HorizontalLayout {
        spacing: 8px;
        if root.busy : Spinner { width: 26px; height: 26px; }
        Button {
            text: root.busy ? (root.progress < 0 ? @tr("处理中…") : round(Math.max(0, Math.min(1, root.progress)) * 100) + "%") : root.text;
            enabled: root.enabled && !root.busy; primary: true;
            clicked => { root.clicked(); }
        }
    }
}

export component ForgeDropDownButton inherits Rectangle {
    in property<string> text: @tr("选择操作");
    in property<[ForgeChoiceItem]> items;
    in property<bool> enabled: true;
    out property<bool> open: popup.is-open;
    callback selected(string);
    public function show() { if root.enabled { popup.show(); } }
    public function close() { popup.close(); }
    min-width: button.min-width; preferred-height: button.preferred-height;
    horizontal-stretch: 0; vertical-stretch: 0;
    button := Button { width: root.width; height: root.height; text: root.text + "      "; enabled: root.enabled; clicked => { popup.show(); } }
    ForgeIcon {
        x: root.width - self.width - 8px; width: 14px * ForgeTypography.scale; height: root.height;
        glyph: ForgeIcons.chevron-down; color: root.enabled ? Palette.foreground : Palette.text-disabled; font-size: 14px * ForgeTypography.scale;

    }
    popup := PopupWindow {
        x: 0px; y: root.height;
        width: Math.max(180px, root.width); height: Math.max(42px, root.items.length * 38px + 12px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Palette.popup-background; border-radius: 8px; border-width: 1px; border-color: Palette.border;
            VerticalLayout {
                padding: 6px; spacing: 4px;
                for item in root.items : Button {
                    text: item.label; enabled: item.enabled && root.enabled;
                    clicked => { root.selected(item.id); popup.close(); }
                }
            }
        }
    }
    changed enabled => { if !root.enabled { popup.close(); } }
}
