import { ForgeFlowTheme } from "theme.slint";
import { ForgeFlowViewport } from "../types/flow.slint";

export component ForgeFlowBackground inherits Rectangle {
    in property<ForgeFlowViewport> viewport;
    // 0 为点阵，1 为网格，2 为无背景图案。缩放很小时自动降低密度。
    in property<int> variant: 0;
    in property<float> gap: 20;
    in property<color> pattern-color: ForgeFlowTheme.grid;
    in property<color> canvas-color: ForgeFlowTheme.canvas;
    private property<float> base-step: Math.max(2, root.gap) * root.viewport.zoom;
    private property<float> step: Math.ceil(16 / root.base-step) * root.base-step;
    // 每列最多 100 个点合并为一个路径，圆端点保持两像素直径。
    private property<string> dot-column: "M 0 0 L 0 0 M 0 1 L 0 1 M 0 2 L 0 2 M 0 3 L 0 3 M 0 4 L 0 4 M 0 5 L 0 5 M 0 6 L 0 6 M 0 7 L 0 7 M 0 8 L 0 8 M 0 9 L 0 9 M 0 10 L 0 10 M 0 11 L 0 11 M 0 12 L 0 12 M 0 13 L 0 13 M 0 14 L 0 14 M 0 15 L 0 15 M 0 16 L 0 16 M 0 17 L 0 17 M 0 18 L 0 18 M 0 19 L 0 19 M 0 20 L 0 20 M 0 21 L 0 21 M 0 22 L 0 22 M 0 23 L 0 23 M 0 24 L 0 24 M 0 25 L 0 25 M 0 26 L 0 26 M 0 27 L 0 27 M 0 28 L 0 28 M 0 29 L 0 29 M 0 30 L 0 30 M 0 31 L 0 31 M 0 32 L 0 32 M 0 33 L 0 33 M 0 34 L 0 34 M 0 35 L 0 35 M 0 36 L 0 36 M 0 37 L 0 37 M 0 38 L 0 38 M 0 39 L 0 39 M 0 40 L 0 40 M 0 41 L 0 41 M 0 42 L 0 42 M 0 43 L 0 43 M 0 44 L 0 44 M 0 45 L 0 45 M 0 46 L 0 46 M 0 47 L 0 47 M 0 48 L 0 48 M 0 49 L 0 49 M 0 50 L 0 50 M 0 51 L 0 51 M 0 52 L 0 52 M 0 53 L 0 53 M 0 54 L 0 54 M 0 55 L 0 55 M 0 56 L 0 56 M 0 57 L 0 57 M 0 58 L 0 58 M 0 59 L 0 59 M 0 60 L 0 60 M 0 61 L 0 61 M 0 62 L 0 62 M 0 63 L 0 63 M 0 64 L 0 64 M 0 65 L 0 65 M 0 66 L 0 66 M 0 67 L 0 67 M 0 68 L 0 68 M 0 69 L 0 69 M 0 70 L 0 70 M 0 71 L 0 71 M 0 72 L 0 72 M 0 73 L 0 73 M 0 74 L 0 74 M 0 75 L 0 75 M 0 76 L 0 76 M 0 77 L 0 77 M 0 78 L 0 78 M 0 79 L 0 79 M 0 80 L 0 80 M 0 81 L 0 81 M 0 82 L 0 82 M 0 83 L 0 83 M 0 84 L 0 84 M 0 85 L 0 85 M 0 86 L 0 86 M 0 87 L 0 87 M 0 88 L 0 88 M 0 89 L 0 89 M 0 90 L 0 90 M 0 91 L 0 91 M 0 92 L 0 92 M 0 93 L 0 93 M 0 94 L 0 94 M 0 95 L 0 95 M 0 96 L 0 96 M 0 97 L 0 97 M 0 98 L 0 98 M 0 99 L 0 99";
    background: root.canvas-color;
    clip: true;
    // 平移只移动整层，点阵复用缓存；网格保持直接绘制，避免非整数 DPI 下线宽量化。
    Rectangle {
        x: (Math.mod(Math.mod(root.viewport.x, root.step) + root.step, root.step) - root.step) * 1px;
        y: (Math.mod(Math.mod(root.viewport.y, root.step) + root.step, root.step) - root.step) * 1px;
        width: root.width + 2 * root.step * 1px;
        height: root.height + 2 * root.step * 1px;
        clip: true;
        cache-rendering-hint: root.variant == 0 && root.viewport.zoom == 1;
        for col in (root.variant == 0 ? 120 : root.variant == 1 ? Math.min(120, Math.ceil(root.width / 1px / root.step) + 2) : 0) : Rectangle {
            visible: root.variant != 0 || col < Math.ceil(root.width / 1px / root.step) + 2;
            x: col * root.step * 1px;
            width: root.variant == 1 ? 1px : 2px; height: parent.height;
            background: root.variant == 1 ? root.pattern-color.with-alpha(0.45) : transparent;
            if root.variant == 0 : Path {
                x: 0px; y: 0px;
                width: 3px; height: (100 * root.step + 2) * 1px;
                viewbox-width: 1; viewbox-height: 100;
                fit: fill;
                commands: root.dot-column;
                fill: transparent; stroke: root.pattern-color; stroke-width: 2px;
                stroke-line-cap: round;
            }
        }
        for row in (root.variant == 1 ? Math.min(100, Math.ceil(root.height / 1px / root.step) + 2) : 0) : Rectangle {
            y: row * root.step * 1px;
            height: 1px; width: parent.width; background: root.pattern-color.with-alpha(0.45);
        }
    }
}
