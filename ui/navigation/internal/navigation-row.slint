import { ForgeTypography } from "../../typography/typography.slint";
import { Palette } from "std-widgets.slint";
import { ForgeNavigationItem, ForgeNavItemKind } from "../../types/navigation.slint";
import { ForgeIcon, ForgeIcons } from "../../icons/icon.slint";

// 导航行只供导航视图使用，不从 @slintforge 导出。
export component ForgeNavigationRow inherits Rectangle {
    in property<ForgeNavigationItem> item;
    in property<bool> compact;
    in property<bool> top-mode: false;
    in property<bool> selected;
    callback activated(string, ForgeNavItemKind);

    height: item.kind == ForgeNavItemKind.separator ? 15px : item.kind == ForgeNavItemKind.header ? 33px : 40px;
    border-radius: selected || touch.has-hover ? 4px : 0px;
    background: selected || touch.has-hover ? Palette.control-background : transparent;

    if item.kind == ForgeNavItemKind.separator : Rectangle {
        x: 9px;
        y: 7px;
        width: parent.width - 18px;
        height: 1px;
        background: Palette.border;
    }
    if item.kind == ForgeNavItemKind.header : Text {
        x: 13px;
        y: 9px;
        text: item.title;
        font-size: 12px * ForgeTypography.scale;
        font-weight: 600;
        color: Palette.foreground;
        visible: !root.compact;
    }
    if root.selected && item.kind == ForgeNavItemKind.page : Rectangle {
        x: 0px;
        y: 9px;
        width: 3px;
        height: 22px;
        border-radius: 2px;
        background: Palette.accent-background;
    }
    if item.kind == ForgeNavItemKind.page || item.kind == ForgeNavItemKind.group : HorizontalLayout {
        x: root.compact ? 4px : root.top-mode ? 8px : 9px + item.depth * 16px;
        width: parent.width - self.x - 8px;
        height: parent.height;
        spacing: 8px;
        ForgeIcon {
            visible: item.icon != "";
            glyph: item.icon;
            width: 20px;
            color: Palette.foreground;
            font-size: 16px * ForgeTypography.scale;
        }
        Text {
            visible: !root.compact;
            text: item.title;
            vertical-alignment: center;
            color: Palette.foreground;
            overflow: elide;
            horizontal-stretch: 1;
            font-size: 14px * ForgeTypography.scale;
        }
        // 使用图标字体：系统 UI 字体缺少“⌄”等符号，会显示为方框。
        ForgeIcon {
            visible: !root.compact && item.has-children;
            glyph: item.expanded ? ForgeIcons.chevron-down : ForgeIcons.chevron-right;
            width: 18px;
            color: Palette.foreground;
            font-size: 12px * ForgeTypography.scale;
        }
    }
    touch := TouchArea {
        enabled: item.enabled && (item.kind == ForgeNavItemKind.page || item.kind == ForgeNavItemKind.group);
        clicked => { root.activated(item.id, item.kind); }
    }
}
