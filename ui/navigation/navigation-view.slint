import { ForgeMetrics } from "../theme/theme.slint";
import { ForgeTypography } from "../typography/typography.slint";
import { Palette } from "std-widgets.slint";
import { ForgeNavPlacement, ForgePaneState, ForgeRouteParam, ForgeNavigationItem } from "../types/navigation.slint";
import { ForgeNavigationPane } from "internal/navigation-pane.slint";
import { ForgeTopNavigation } from "internal/top-navigation.slint";
import { ForgeIcon, ForgeIcons } from "../icons/icon.slint";

export component ForgeNavigationView inherits Rectangle {
    in property<[ForgeNavigationItem]> items;
    in property<[ForgeNavigationItem]> tree-items;
    in property<[ForgeNavigationItem]> footer-items;
    in property<string> active-route-id;
    in property<string> active-top-id;
    in property<ForgeNavPlacement> placement: ForgeNavPlacement.left;
    in property<ForgePaneState> pane-state: ForgePaneState.expanded;
    in property<string> brand: "SlintForge Gallery";
    in property<string> search-query: "";
    in property<bool> can-go-back: false;
    in property<bool> dark-mode: false;
    in property<bool> show-app-bar: true;
    in property<bool> show-pane-header: true;
    in property<bool> show-pane-search: true;
    // 内容尺寸由导航布局唯一计算，嵌入页面无需重复扣除侧栏或顶部导航。
    out property<length> content-width: content.width;
    out property<length> content-height: content.height;
    out property<length> content-x: content.x;
    out property<length> content-y: body.y;
    callback navigate-requested(string, [ForgeRouteParam]);
    callback group-toggle-requested(string);
    callback pane-state-requested(ForgePaneState);
    callback search-requested(string);
    callback back-requested();
    callback theme-toggle-requested();
    background: Palette.background;
    property<length> side-width: root.placement == ForgeNavPlacement.top || root.pane-state == ForgePaneState.hidden ? 0px : root.pane-state == ForgePaneState.compact ? ForgeMetrics.compact-pane-width : ForgeMetrics.pane-width;

    // 菜单按钮只在完整菜单和图标栏之间切换；隐藏仍可由应用显式设置。
    public function toggle-pane() {
        root.pane-state-requested(root.pane-state == ForgePaneState.expanded ? ForgePaneState.compact : ForgePaneState.expanded);
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        if root.show-app-bar : Rectangle {
            x: 0px; y: 0px; width: parent.width;
            height: ForgeMetrics.title-bar-height;
            background: Palette.background;
            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: 5px;
                padding-right: 12px;
                spacing: 4px;
                Rectangle {
                    width: 38px; height: 36px;
                    border-radius: ForgeMetrics.control-radius;
                    background: back-touch.has-hover && root.can-go-back ? Palette.control-background : transparent;
                    // 应用栏按钮使用图标字体，系统 UI 字体缺少 ☰、☼ 等符号。
                    ForgeIcon { glyph: ForgeIcons.arrow-left; font-size: 16px * ForgeTypography.scale; color: root.can-go-back ? Palette.foreground : Palette.text-disabled; }
                    back-touch := TouchArea { enabled: root.can-go-back; clicked => { root.back-requested(); } }
                }
                Rectangle {
                    width: 36px; height: 36px;
                    border-radius: ForgeMetrics.control-radius;
                    background: menu-touch.has-hover ? Palette.control-background : transparent;
                    ForgeIcon { glyph: ForgeIcons.navigation; font-size: 16px * ForgeTypography.scale; }
                    menu-touch := TouchArea { clicked => { root.toggle-pane(); } }
                }
                Rectangle {
                    width: 19px; height: 19px; border-radius: 5px; background: Palette.accent-background;
                    Text { text: "S"; color: Palette.accent-foreground; font-size: 12px * ForgeTypography.scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: root.brand; color: Palette.foreground; font-size: 14px * ForgeTypography.scale; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle {
                    width: 38px; height: 36px; border-radius: ForgeMetrics.control-radius;
                    background: theme-touch.has-hover ? Palette.control-background : transparent;
                    ForgeIcon { glyph: root.dark-mode ? ForgeIcons.sun : ForgeIcons.moon; font-size: 16px * ForgeTypography.scale; }
                    theme-touch := TouchArea { clicked => { root.theme-toggle-requested(); } }
                }
                Text { text: "v0.1.2"; color: Palette.foreground; font-size: 12px * ForgeTypography.scale; vertical-alignment: center; }
            }
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Palette.divider; }
        }
        if root.placement == ForgeNavPlacement.top && root.pane-state != ForgePaneState.hidden : ForgeTopNavigation {
            x: 0px;
            y: root.show-app-bar ? ForgeMetrics.title-bar-height : 0px;
            width: parent.width;
            items: root.search-query != "" ? root.items : root.tree-items.length > 0 ? root.tree-items : root.items;
            search-active: root.search-query != "";
            active-route-id: root.active-route-id;
            active-top-id: root.active-top-id;
            pane-state: root.pane-state;
            navigate-requested(id) => { root.navigate-requested(id, []); }
        }
        body := Rectangle {
            x: 0px;
            y: (root.show-app-bar ? ForgeMetrics.title-bar-height : 0px) + (root.placement == ForgeNavPlacement.top && root.pane-state != ForgePaneState.hidden ? 48px : 0px);
            width: parent.width;
            height: Math.max(0px, parent.height - self.y);
            background: Palette.background;
            if root.placement == ForgeNavPlacement.left && root.pane-state != ForgePaneState.hidden : ForgeNavigationPane {
                x: 0px; width: root.side-width; height: parent.height;
                items: root.items;
                footer-items: root.footer-items;
                active-route-id: root.active-route-id;
                pane-state: root.pane-state;
                show-header: root.show-pane-header;
                show-search: root.show-pane-search;
                search-query: root.search-query;
                navigate-requested(id) => { root.navigate-requested(id, []); }
                group-toggle-requested(id) => { root.group-toggle-requested(id); }
                search-requested(value) => { root.search-requested(value); }
                expand-requested => { root.pane-state-requested(ForgePaneState.expanded); }
            }
            content := Rectangle {
                x: root.placement == ForgeNavPlacement.left ? root.side-width : 0px;
                width: parent.width - root.side-width;
                height: parent.height;
                background: Palette.content-background;
                @children
            }
            if root.placement == ForgeNavPlacement.right && root.pane-state != ForgePaneState.hidden : ForgeNavigationPane {
                x: parent.width - root.side-width; width: root.side-width; height: parent.height;
                items: root.items;
                footer-items: root.footer-items;
                active-route-id: root.active-route-id;
                pane-state: root.pane-state;
                show-header: root.show-pane-header;
                show-search: root.show-pane-search;
                search-query: root.search-query;
                navigate-requested(id) => { root.navigate-requested(id, []); }
                group-toggle-requested(id) => { root.group-toggle-requested(id); }
                search-requested(value) => { root.search-requested(value); }
                expand-requested => { root.pane-state-requested(ForgePaneState.expanded); }
            }
            // 分隔线绘在侧栏内缘，保留内容尺寸与无缝相接的几何契约。
            if root.side-width > 0px : Rectangle {
                x: root.placement == ForgeNavPlacement.left ? root.side-width - 1px : parent.width - root.side-width;
                width: 1px; height: parent.height;
                background: Palette.divider;
            }
        }
    }
}
