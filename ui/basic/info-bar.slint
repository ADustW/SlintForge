import { Palette } from "std-widgets.slint";

import { ForgeInfoLevel } from "../types/feedback.slint";

import { ForgeIconButton } from "icon-button.slint";

export component ForgeInfoBar inherits Rectangle {
    in property<ForgeInfoLevel> level: ForgeInfoLevel.info;
    in property<string> message;
    in property<bool> dismissible: true;
    property<color> accent-color: root.level == ForgeInfoLevel.success ? Palette.success : root.level == ForgeInfoLevel.warning ? Palette.warning : root.level == ForgeInfoLevel.error ? Palette.error : Palette.accent-background;
    callback dismissed();
    min-height: 44px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.border;
    background: root.level == ForgeInfoLevel.success ? Palette.success-background : root.level == ForgeInfoLevel.warning ? Palette.warning-background : root.level == ForgeInfoLevel.error ? Palette.error-background : Palette.content-background;
    Rectangle { x: 0px; y: 0px; width: 4px; height: parent.height; background: root.accent-color; }
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Text {
            text: root.level == ForgeInfoLevel.success ? "+" : root.level == ForgeInfoLevel.warning ? "!" : root.level == ForgeInfoLevel.error ? "x" : "i";
            width: 20px;
            vertical-alignment: center;
            horizontal-alignment: center;
            color: root.accent-color;
        }
        Text { text: root.message; vertical-alignment: center; color: Palette.foreground; wrap: word-wrap; }
        if root.dismissible : ForgeIconButton { icon: "x"; clicked => { root.dismissed(); } }
    }
}
