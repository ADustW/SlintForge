import { ForgeMetrics } from "../theme/theme.slint";
import { Palette } from "std-widgets.slint";

export component ForgeIconButton inherits Rectangle {
    in property<string> icon;
    in property<string> label;
    in property<bool> selected: false;
    in property<bool> enabled: true;
    out property<bool> has-focus: focus.has-focus;
    callback clicked();
    width: root.label == "" ? 36px : icon-text.preferred-width + label-text.preferred-width + 26px;
    height: ForgeMetrics.control-height;
    horizontal-stretch: 0;
    border-radius: ForgeMetrics.control-radius;
    border-width: ForgeMetrics.stroke-width;
    border-color: focus.has-focus ? Palette.focus-stroke-outer : selected ? Palette.accent-control-border : Palette.control-border;
    background: !root.enabled ? Palette.control-disabled : selected ? (button-touch.pressed ? Palette.tertiary-accent-background : button-touch.has-hover ? Palette.secondary-accent-background : Palette.accent-background) : button-touch.pressed ? Palette.control-tertiary : button-touch.has-hover ? Palette.control-secondary : Palette.control-background;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label == "" ? root.icon : root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        icon-text := Text { text: root.icon; visible: root.icon != ""; vertical-alignment: center; color: !root.enabled ? Palette.text-disabled : selected ? Palette.accent-foreground : Palette.foreground; }
        label-text := Text { text: root.label; visible: root.label != ""; vertical-alignment: center; color: !root.enabled ? Palette.text-disabled : selected ? Palette.accent-foreground : Palette.foreground; }
    }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
    button-touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}
