import { Button, Palette } from "std-widgets.slint";
import { ForgeTourStep } from "../types/widgets.slint";
import { ForgeTypography } from "../typography/typography.slint";

export component ForgeTour inherits Rectangle {
    in property<[ForgeTourStep]> steps;
    in-out property<bool> active: false;
    in-out property<int> current-step: 0;
    private property<ForgeTourStep> step-data: root.steps[Math.max(0, Math.min(root.steps.length - 1, root.current-step))];
    private property<length> left-edge: Math.max(0px, Math.min(root.width, root.step-data.x));
    private property<length> top-edge: Math.max(0px, Math.min(root.height, root.step-data.y));
    private property<length> right-edge: Math.max(root.left-edge, Math.min(root.width, root.step-data.x + root.step-data.width));
    private property<length> bottom-edge: Math.max(root.top-edge, Math.min(root.height, root.step-data.y + root.step-data.height));
    callback finished();
    callback dismissed();
    callback step-changed(int);
    public function start() { root.current-step = 0; root.active = root.steps.length > 0; if root.active { scope.focus(); } }
    public function next() {
        if !root.active || root.steps.length == 0 { return; }
        if root.current-step + 1 >= root.steps.length { root.active = false; root.finished(); }
        else { root.current-step += 1; root.step-changed(root.current-step); }
    }
    public function previous() { if root.active && root.current-step > 0 { root.current-step -= 1; root.step-changed(root.current-step); } }
    public function dismiss() { if root.active { root.active = false; root.dismissed(); } }
    visible: root.active && root.steps.length > 0;
    forward-focus: scope;
    scope := FocusScope {
        enabled: root.active;
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); return accept; }
            if event.text == Key.RightArrow { root.next(); return accept; }
            if event.text == Key.LeftArrow { root.previous(); return accept; }
            return reject;
        }
    TouchArea { }
    Rectangle { x: 0px; y: 0px; width: root.width; height: root.top-edge; background: #000000a0; }
    Rectangle { x: 0px; y: root.bottom-edge; width: root.width; height: Math.max(0px, root.height - root.bottom-edge); background: #000000a0; }
    Rectangle { x: 0px; y: root.top-edge; width: root.left-edge; height: root.bottom-edge - root.top-edge; background: #000000a0; }
    Rectangle { x: root.right-edge; y: root.top-edge; width: Math.max(0px, root.width - root.right-edge); height: root.bottom-edge - root.top-edge; background: #000000a0; }
    Rectangle { x: root.left-edge; y: root.top-edge; width: root.right-edge - root.left-edge; height: root.bottom-edge - root.top-edge; background: transparent; border-width: 2px; border-color: Palette.accent-background; border-radius: 6px; }
    Rectangle {
        width: Math.min(380px, Math.max(0px, root.width - 24px)); height: layout.preferred-height;
        x: Math.max(12px, Math.min(root.width - self.width - 12px, root.left-edge));
        y: Math.max(12px, Math.min(root.height - self.height - 12px, root.bottom-edge + 14px));
        background: Palette.background; border-radius: 8px; border-width: 1px; border-color: Palette.border;
        layout := VerticalLayout {
            padding: 18px; spacing: 12px;
            Text { text: root.step-data.title + " · " + (root.current-step + 1) + "/" + root.steps.length; color: Palette.foreground; font-size: 18px * ForgeTypography.scale; font-weight: 600; wrap: word-wrap; }
            Text { text: root.step-data.description; color: Palette.foreground; font-size: 14px * ForgeTypography.scale; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 6px;
                Button { text: @tr("跳过"); clicked => { root.dismiss(); } }
                Button { text: @tr("上一步"); enabled: root.current-step > 0; clicked => { root.previous(); } }
                Button { text: root.current-step + 1 == root.steps.length ? @tr("完成") : @tr("下一步"); primary: true; clicked => { root.next(); } }
            }
        }
    }
    }
    changed steps => { root.current-step = Math.max(0, Math.min(Math.max(0, root.steps.length - 1), root.current-step)); if root.steps.length == 0 { root.active = false; } }
    changed active => { if root.active { root.current-step = 0; scope.focus(); } }
    changed current-step => { root.current-step = Math.max(0, Math.min(Math.max(0, root.steps.length - 1), root.current-step)); }
}
