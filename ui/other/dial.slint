import { Palette } from "std-widgets.slint";
import { ForgeTypography } from "../typography/typography.slint";

export component ForgeDial inherits Rectangle {
    in-out property<float> value: 0;
    in property<float> minimum: 0;
    in property<float> maximum: 100;
    in property<float> step: 1;
    in property<bool> enabled: true;
    in property<string> suffix;
    out property<angle> needle-angle: (-135 + (root.maximum <= root.minimum ? 0 : (root.value - root.minimum) / (root.maximum - root.minimum)) * 270) * 1deg;
    private property<float> drag-value;
    private property<length> drag-y;
    callback value-changed(float);
    init => { root.value = Math.max(root.minimum, Math.min(Math.max(root.minimum, root.maximum), root.value)); }
    public function set-value(candidate: float) {
        if root.enabled { root.value = Math.max(root.minimum, Math.min(Math.max(root.minimum, root.maximum), candidate)); root.value-changed(root.value); }
    }
    changed value => { root.value = Math.max(root.minimum, Math.min(Math.max(root.minimum, root.maximum), root.value)); }
    changed minimum => { root.value = Math.max(root.minimum, Math.min(Math.max(root.minimum, root.maximum), root.value)); }
    changed maximum => { root.value = Math.max(root.minimum, Math.min(Math.max(root.minimum, root.maximum), root.value)); }
    preferred-width: 180px; preferred-height: 180px;
    min-width: 100px; min-height: 100px; forward-focus: scope;
    accessible-role: slider; accessible-value: root.value; accessible-value-minimum: root.minimum; accessible-value-maximum: root.maximum;
    opacity: root.enabled ? 1 : 0.45;
    wheel := Rectangle {
        width: Math.min(root.width, root.height) - 8px; height: self.width;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        border-radius: self.width / 2; background: Palette.control-background;
        border-width: scope.has-focus ? 3px : 1px; border-color: scope.has-focus ? Palette.accent-background : Palette.border;
        for index in 11 : Rectangle {
            private property<angle> tick-angle: (-135 + index * 27) * 1deg;
            width: 4px; height: 4px; border-radius: 2px; background: Palette.foreground;
            x: parent.width / 2 + Math.sin(self.tick-angle) * parent.width * 0.43 - 2px;
            y: parent.height / 2 - Math.cos(self.tick-angle) * parent.height * 0.43 - 2px;
        }
        Rectangle {
            width: 12px; height: 12px; border-radius: 6px; background: Palette.accent-background;
            x: parent.width / 2 + Math.sin(root.needle-angle) * parent.width * 0.33 - 6px;
            y: parent.height / 2 - Math.cos(root.needle-angle) * parent.height * 0.33 - 6px;
        }
        Text { text: round(root.value * 100) / 100 + root.suffix; color: Palette.foreground; font-size: 20px * ForgeTypography.scale; horizontal-alignment: center; vertical-alignment: center; }
    }
    scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.UpArrow || event.text == Key.RightArrow { root.set-value(root.value + Math.max(0, root.step)); return accept; }
            if event.text == Key.DownArrow || event.text == Key.LeftArrow { root.set-value(root.value - Math.max(0, root.step)); return accept; }
            if event.text == Key.Home { root.set-value(root.minimum); return accept; }
            if event.text == Key.End { root.set-value(root.maximum); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        changed pressed => { if self.pressed { scope.focus(); root.drag-value = root.value; root.drag-y = self.mouse-y; } }
        moved => { if self.pressed { root.set-value(root.drag-value + (root.drag-y - self.mouse-y) / 140px * Math.max(0, root.maximum - root.minimum)); } }
        scroll-event(event) => {
            if event.delta-y == 0px || root.step <= 0 { return reject; }
            root.set-value(root.value + (event.delta-y > 0px ? root.step : -root.step));
            return accept;
        }
    }
}
