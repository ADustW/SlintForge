import { Palette } from "std-widgets.slint";
import { ForgeIcon, ForgeIcons } from "../icons/icon.slint";
import { ForgeTypography } from "../typography/typography.slint";

export component ForgeExpander inherits Rectangle {
    in property<string> title;
    in-out property<bool> expanded: false;
    // 正值为显式高度；零或负值使用调用方内容布局的自然高度。
    in property<length> content-height: 0px;
    in property<length> content-padding: 12px;
    in property<bool> enabled: true;
    out property<length> natural-content-height: slot.preferred-height + 2 * Math.max(0px, root.content-padding);
    property<length> header-height: Math.max(44px, header-label.preferred-height + 16px);
    property<length> body-height: root.content-height > 0px ? root.content-height : root.natural-content-height;
    callback toggled(bool);
    public function toggle() {
        if (root.enabled) {
            root.expanded = !root.expanded;
            root.toggled(root.expanded);
        }
    }
    height: root.header-height + (root.expanded ? root.body-height : 0px);
    border-radius: 7px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.alternate-background;
    clip: true;
    Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: root.header-height;
        background: header-touch.has-hover ? Palette.control-background : transparent;
        ForgeIcon {
            x: 12px; y: (parent.height - 24px) / 2; width: 24px; height: 24px;
            glyph: root.expanded ? ForgeIcons.chevron-down : ForgeIcons.chevron-right;
            font-size: 18px * ForgeTypography.scale;
        }
        header-label := Text {
            x: 44px; width: Math.max(0px, parent.width - 56px); height: parent.height;
            text: root.title; color: Palette.foreground;
            font-size: 14px * ForgeTypography.scale; font-weight: 600;
            wrap: word-wrap; vertical-alignment: center;
        }
        header-focus := FocusScope {
            enabled: root.enabled;
            accessible-role: button;
            accessible-label: root.title;
            accessible-expandable: true;
            accessible-expanded: root.expanded;
            accessible-enabled: root.enabled;
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == " ") {
                    root.toggle();
                    return accept;
                }
                return reject;
            }
        }
        header-touch := TouchArea {
            enabled: root.enabled;
            clicked => { header-focus.focus(); root.toggle(); }
        }
        Rectangle {
            visible: header-focus.has-focus;
            border-radius: 6px; border-width: 2px;
            border-color: Palette.accent-background;
            background: transparent;
        }
    }
    Rectangle {
        y: root.header-height; width: parent.width; height: root.body-height;
        visible: root.expanded;
        clip: true;
        background: Palette.background;
        slot := Rectangle {
            x: Math.max(0px, root.content-padding); y: self.x;
            width: Math.max(0px, parent.width - 2 * self.x);
            height: Math.max(0px, parent.height - 2 * self.y);
            @children
        }
    }
}
