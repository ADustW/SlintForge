import { ForgeMetrics } from "../theme/theme.slint";
import { LineEdit, Palette } from "std-widgets.slint";
import { ForgeTitleBarButton } from "internal/title-bar-button.slint";
import { ForgeTypography } from "../typography/typography.slint";
import { ForgeIcon, ForgeIcons } from "../icons/icon.slint";
import { ForgeCaptureService, ForgeCaptureResult } from "../types/capture.slint";

// 公共无边框窗口：原生窗口负责拖动与缩放，内容通过 @children 常驻于标题栏下方。
export component ForgeWindow inherits Window {
    no-frame: true;
    resize-border-width: 6px;
    background: Palette.background;
    default-font-family: ForgeTypography.resolved-family;
    default-font-size: ForgeTypography.body;
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 420px;
    min-height: 240px;

    in property<string> brand-symbol: "S";
    in property<image> brand-icon;
    in property<bool> show-brand-icon: false;
    in property<string> version-text: "";
    in property<bool> show-menu-button: false;
    in property<bool> leading-menu-button: false;
    in property<bool> show-back-button: false;
    in property<bool> back-enabled: false;
    in property<bool> show-search-box: false;
    in property<string> search-text;
    in property<string> search-placeholder: @tr("搜索组件");
    out property<bool> search-has-focus: root.show-search-box && search-input.has-focus;
    in property<string> navigation-glyph: ForgeIcons.panel-left;
    in property<bool> show-theme-button: false;
    in property<bool> show-pin-button: false;
    in property<bool> show-settings-button: false;
    in property<bool> show-maximize-button: true;
    in-out property<bool> dark-mode: false;
    in-out property<bool> pinned: false;
    in-out property<bool> rounded-corners: true;
    always-on-top: root.pinned;
    out property<length> title-bar-height: ForgeMetrics.title-bar-height;
    callback menu-requested();
    callback back-clicked();
    callback search-edited(string);
    callback search-accepted(string);
    callback theme-toggle-requested();
    callback pin-state-changed(bool);
    callback settings-requested();

    public function focus-search() {
        if root.show-search-box { search-input.focus(); }
    }

    public function capture() -> ForgeCaptureResult {
        if (!ForgeCaptureService.connected) {
            return { error: @tr("截图服务未接入") };
        }
        return ForgeCaptureService.capture-window();
    }

    Rectangle {
        x: 0px; y: 0px;
        width: root.width; height: root.title-bar-height;
        background: Palette.background;
        HorizontalLayout {
            width: parent.width; height: parent.height;
            spacing: 0px;
            padding: 0px;
            if root.show-back-button : ForgeTitleBarButton {
                role: 8;
                navigation-style: true;
                enabled: root.back-enabled;
                clicked => { root.back-clicked(); }
            }
            if root.show-menu-button && root.leading-menu-button : ForgeTitleBarButton {
                role: 1;
                navigation-style: true;
                glyph: root.navigation-glyph;
                clicked => { root.menu-requested(); }
            }
            WindowMoveArea {
                horizontal-stretch: root.show-search-box ? 0 : 1;
                min-width: root.show-search-box ? 120px : 0px;
                preferred-width: 220px;
                max-width: root.show-search-box ? 220px : 100000px;
                height: root.title-bar-height;
                HorizontalLayout {
                    width: parent.width; height: parent.height;
                    padding-left: root.leading-menu-button ? 8px : 10px;
                    padding-right: 8px;
                    spacing: 9px;
                    Rectangle {
                        width: 18px; height: root.title-bar-height;
                        background: transparent;
                        if root.show-brand-icon : Image {
                            x: 0px; y: (parent.height - 18px) / 2;
                            width: 18px; height: 18px;
                            source: root.brand-icon;
                            image-fit: contain;
                        }
                        if !root.show-brand-icon : Rectangle {
                            x: 0px; y: (parent.height - 18px) / 2;
                            width: 18px; height: 18px;
                            border-radius: 5px;
                            background: Palette.accent-background;
                            Text {
                                width: parent.width; height: parent.height;
                                text: root.brand-symbol;
                                color: Palette.accent-foreground;
                                font-size: 12px * ForgeTypography.scale;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        height: root.title-bar-height;
                        text: root.title + (root.version-text == "" ? "" : " (" + root.version-text + ")");
                        color: Palette.foreground;
                        font-size: 12px * ForgeTypography.scale;
                        font-weight: 400;
                        horizontal-stretch: 1;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                TouchArea {
                    double-clicked => {
                        if (root.show-maximize-button) { root.maximized = !root.maximized; }
                    }
                }
            }
            if root.show-search-box : WindowMoveArea {
                horizontal-stretch: 1;
                min-width: 8px;
                height: root.title-bar-height;
                TouchArea { double-clicked => { if root.show-maximize-button { root.maximized = !root.maximized; } } }
            }
            // 搜索框独立于拖动区域，编辑、选择文字和清空操作不会移动窗口。
            Rectangle {
                visible: root.show-search-box;
                min-width: root.show-search-box ? 160px : 0px;
                preferred-width: root.show-search-box ? 480px : 0px;
                max-width: root.show-search-box ? 480px : 0px;
                horizontal-stretch: 1;
                height: root.title-bar-height;
                search-input := LineEdit {
                    x: 0px; y: (parent.height - self.height) / 2;
                    width: parent.width; height: ForgeMetrics.title-bar-search-height;
                    min-width: 0px;
                    text: root.search-text;
                    placeholder-text: root.search-placeholder;
                    font-size: ForgeTypography.body;
                    edited(value) => { root.search-edited(value); }
                    accepted(value) => { root.search-accepted(value); }
                    key-pressed(event) => {
                        if event.text == Key.Escape { root.search-edited(""); return accept; }
                        return reject;
                    }
                }
                ForgeIcon {
                    x: parent.width - 26px; y: (parent.height - self.height) / 2; width: 16px; height: 16px;
                    glyph: ForgeIcons.search;
                    font-size: 14px;
                    color: Palette.text-secondary;
                    visible: !search-input.has-focus || root.search-text == "";
                }
            }
            if root.show-search-box : WindowMoveArea {
                horizontal-stretch: 1;
                min-width: 12px;
                height: root.title-bar-height;
                TouchArea { double-clicked => { if root.show-maximize-button { root.maximized = !root.maximized; } } }
            }
            if root.show-theme-button : ForgeTitleBarButton {
                role: 2;
                dark-mode: root.dark-mode;
                clicked => { root.theme-toggle-requested(); }
            }
            if root.show-pin-button : ForgeTitleBarButton {
                role: 6;
                pinned-state: root.pinned;
                clicked => { root.pinned = !root.pinned; root.pin-state-changed(root.pinned); }
            }
            if root.show-menu-button && !root.leading-menu-button : ForgeTitleBarButton {
                role: 1;
                glyph: root.navigation-glyph;
                clicked => { root.menu-requested(); }
            }
            if root.show-settings-button : ForgeTitleBarButton {
                role: 7;
                clicked => { root.settings-requested(); }
            }
            ForgeTitleBarButton {
                role: 3;
                clicked => { root.minimized = true; }
            }
            if root.show-maximize-button : ForgeTitleBarButton {
                role: 4;
                maximized-state: root.maximized;
                clicked => { root.maximized = !root.maximized; }
            }
            ForgeTitleBarButton {
                role: 5;
                clicked => { root.close(); }
            }
        }
        Rectangle {
            x: 0px; y: parent.height - 1px;
            width: parent.width; height: 1px;
            background: Palette.divider;
        }
    }
    Rectangle {
        x: 0px; y: root.title-bar-height;
        width: root.width;
        height: root.height - root.title-bar-height;
        background: Palette.background;
        @children
    }
    Rectangle {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        border-width: root.maximized ? 0px : 1px;
        border-color: Palette.border;
        background: transparent;
    }
}
