// 专业二维绘图的共享契约；枚举顺序对应共用数值引擎的公开常量。
export enum ForgePlotKind { graph, curve, bars, statistical-box, candlestick, ohlc, polar }
export enum ForgePlotLineStyle { auto, none, line, step-left, step-right, step-center, impulse }
export enum ForgePlotScatterStyle { none, circle, disc, square, diamond, cross, cross-plus, triangle, plus, star }
export enum ForgePlotAxisSide { bottom, top, left, right }
export enum ForgePlotScale { linear, logarithmic }
export enum ForgePlotTicker { numeric, text, date-time, duration, pi }
export enum ForgePlotLegendPosition { bottom, top, left, right, top-right, bottom-right, top-left, bottom-left }
export enum ForgePlotPlacement { inside, outside }
export enum ForgePlotLegendStyle { plain, framed, compact }
export enum ForgePlotXWindowMode { fit, unlimited, fixed }
export enum ForgePlotItemKind { text, line, arrow, rectangle, ellipse, curve, bracket, tracer, image }
export enum ForgePlotCoordinates { data, ratio, pixel }
export struct ForgePlotPoint {
    x: float, y: float, low: float, high: float, open: float, close: float, q1: float, q3: float,
    error-x-minus: float, error-x-plus: float, error-y-minus: float, error-y-plus: float,
    label: string, outliers: [float],
}
export struct ForgePlotTick { value: float, label: string }
export struct ForgePlotAxis {
    id: int, panel: int, side: ForgePlotAxisSide, scale: ForgePlotScale, ticker: ForgePlotTicker,
    manual-range: bool, reversed: bool, hidden: bool, hide-grid: bool, precision: int,
    minimum: float, maximum: float, tick-step: float, offset: float,
    label: string, format: string, time-origin: string, ticks: [ForgePlotTick],
}
export struct ForgePlotPanel { id: int, x: float, y: float, width: float, height: float, title: string }
export struct ForgePlotSeries {
    id: int, kind: ForgePlotKind, x-axis: int, y-axis: int,
    line-style: ForgePlotLineStyle, scatter-style: ForgePlotScatterStyle,
    hidden: bool, unselectable: bool, stacked: bool, stack-group: int,
    channel-fill: bool, fill-target: int, layer: int, sorted: bool,
    color: color, fill-color: color, line-width: float, point-size: float, bar-width: float, baseline: float,
    name: string, points: [ForgePlotPoint],
}
export struct ForgePlotColorMap {
    id: int, panel: int, x-axis: int, y-axis: int, columns: int, rows: int, palette: int,
    manual-range: bool, logarithmic: bool, hidden: bool, interpolate: bool, hide-color-scale: bool, layer: int,
    x-min: float, x-max: float, y-min: float, y-max: float, z-min: float, z-max: float,
    name: string, values: [float],
}
export struct ForgePlotItem {
    id: int, kind: ForgePlotItemKind, panel: int, x-axis: int, y-axis: int, coordinates: ForgePlotCoordinates,
    anchored: bool, anchor: int, anchor-part: int, unclipped: bool, layer: int, selectable: bool,
    x: float, y: float, x2: float, y2: float, x3: float, y3: float, x4: float, y4: float, width: float, size: float,
    color: color, fill-color: color, text: string, image-data: string,
}
export struct ForgePlotOptions {
    width: float, height: float, font-size: float, background: color, foreground: color, grid-color: color, selection-color: color,
    hide-legend: bool, disable-adaptive: bool, disable-antialias: bool, max-points-per-pixel: int,
    legend-position: ForgePlotLegendPosition, legend-style: ForgePlotLegendStyle, legend-latest-value: bool, legend-precision: int,
    legend-placement: ForgePlotPlacement,
    measurement-enabled: bool, measurement-position: ForgePlotLegendPosition, measurement-placement: ForgePlotPlacement, measurement-series: int,
    measurement-width: float, measurement-height: float,
    x-window-mode: ForgePlotXWindowMode, x-window-axis: int, x-window-size: float,
    title: string, font-family: string, revision: int, stream-revision: int, render-scale: float,
}
export struct ForgePlotRange { id: int, scale: int, reversed: bool, minimum: float, maximum: float }
export struct ForgePlotRect { id: int, x: float, y: float, width: float, height: float }
export struct ForgePlotHit {
    kind: int, id: int, index: int, panel: int, x: float, y: float, value: float,
    pixel-x: float, pixel-y: float, distance: float, label: string,
}
export struct ForgePlotSelection { id: int, first: int, last: int }
export struct ForgePlotScene {
    token: int, status: int, image: image, svg: string, error: string,
    input-points: int, rendered-points: int, path-count: int, svg-bytes: int,
    ranges: [ForgePlotRange], domains: [ForgePlotRange], rects: [ForgePlotRect],
    window-range: ForgePlotRange, history-range: ForgePlotRange,
    legend-rect: ForgePlotRect, measurement-rect: ForgePlotRect,
    measurement-axis: int, measurement-range: ForgePlotRange,
}
export struct ForgePlotExportResult { ok: bool, error: string }
export global ForgePlotServices {
    in-out property<bool> connected: false;
    callback allocate() -> int;
    callback release(int);
    callback append(int, int, [ForgePlotPoint]) -> bool;
    pure callback measure(int, int, float) -> ForgePlotHit;
    pure callback prepare(int, [ForgePlotAxis], [ForgePlotPanel], [ForgePlotSeries], [ForgePlotColorMap], [ForgePlotItem], [ForgePlotSelection], ForgePlotOptions) -> ForgePlotScene;
    pure callback hit-test(int, float, float, float) -> ForgePlotHit;
    pure callback coordinate(int, int, float, bool) -> float;
    callback select-rect(int, float, float, float, float) -> [ForgePlotSelection];
    callback merge-selection([ForgePlotSelection], [ForgePlotSelection], int) -> [ForgePlotSelection];
    callback change-view(int, [ForgePlotAxis], [ForgePlotRange], int, int, float, float, float, float, int) -> [ForgePlotAxis];
    callback scroll-view(int, [ForgePlotAxis], int, float, float) -> [ForgePlotAxis];
    callback toggle-series([ForgePlotSeries], int) -> [ForgePlotSeries];
    callback export(int, string, string) -> ForgePlotExportResult;
}
