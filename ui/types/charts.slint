// 图表的数据与归一化几何契约；两端只计算几何，实际绘制共用 Slint。
export enum ForgeChartKind { bar, line, pie, polar, bubble, scatter, radar }
export struct ForgeChartPoint { x: float, y: float, size: float, label: string, color: color }
export struct ForgeChartSeries { name: string, color: color, points: [ForgeChartPoint], hidden: bool }
export struct ForgeChartSlice { label: string, value: float, color: color, hidden: bool }
export struct ForgeChartOptions {
    auto-range: bool, x-min: float, x-max: float, y-min: float, y-max: float,
    include-zero: bool, stacked: bool, smooth: bool, fill-area: bool,
    doughnut: bool, point-size: float, precision: int, revision: int,
}
export struct ForgeChartMark {
    kind: int, x: float, y: float, width: float, height: float, radius: float,
    x1: float, y1: float, x2: float, y2: float, x3: float, y3: float,
    start-angle: float, sweep-angle: float, color: color,
    series-index: int, point-index: int, value: float, label: string,
}
export struct ForgeChartLine {
    x: float, y: float, x1: float, y1: float,
    c1x: float, c1y: float, c2x: float, c2y: float, color: color,
}
export struct ForgeChartTick { position: float, label: string }
export struct ForgeChartLabel { x: float, y: float, text: string }
export struct ForgeChartScene {
    status: int, x-min: float, x-max: float, y-min: float, y-max: float,
    zero-y: float, inner-radius: float,
    marks: [ForgeChartMark], areas: [ForgeChartMark], lines: [ForgeChartLine],
    x-ticks: [ForgeChartTick], y-ticks: [ForgeChartTick], labels: [ForgeChartLabel],
}
export global ForgeChartServices {
    in-out property<bool> connected: false;
    pure callback prepare(int, [ForgeChartSeries], [ForgeChartSlice], [string], ForgeChartOptions) -> ForgeChartScene;
    callback hit-test([ForgeChartMark], float, float, float, float, float) -> int;
}
