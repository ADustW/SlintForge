// 应用可在运行时覆盖字体与缩放；缺失字体及中文由 Slint 系统字体集合回退。
export global ForgeTypography {
    in-out property<string> family: "";
    out property<string> resolved-family: self.family == "" ? "Segoe UI Variable" : self.family;
    in-out property<float> scale: 1.0;
    out property<length> caption: 12px * self.scale;
    out property<length> body: 14px * self.scale;
    out property<length> subtitle: 20px * self.scale;
    out property<length> title: 28px * self.scale;
}
