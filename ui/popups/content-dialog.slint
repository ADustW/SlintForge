import { ForgeMetrics } from "../theme/theme.slint";
import { Palette, ScrollView } from "std-widgets.slint";
import { ForgePillButton } from "../inputs/action-buttons.slint";
import { ForgeTypography } from "../typography/typography.slint";

export component ForgeContentDialog inherits Rectangle {
    in-out property<bool> open: false;
    in property<string> title;
    in property<string> message;
    in property<string> primary-text: @tr("确定");
    in property<string> cancel-text: @tr("取消");
    in property<bool> primary-enabled: true;
    in property<bool> dismiss-on-outside: false;
    callback accepted();
    callback canceled();
    // 返回 true 表示调用方已经处理焦点，未绑定时继续使用确认框的默认顺序。
    callback initial-focus-requested() -> bool;
    callback focus-next-requested(reverse: bool) -> bool;
    callback focus-return-requested();
    out property<bool> primary-has-focus: accept-button.has-focus;
    out property<bool> cancel-has-focus: cancel-button.has-focus;
    private property<int> focus-index: 0;
    public function focus-primary-button() { if root.open && root.primary-enabled { root.focus-index = 0; accept-button.focus-button(); } }
    public function focus-cancel-button() { if root.open { root.focus-index = 1; cancel-button.focus-button(); } }
    public function dismiss() { if root.open { root.open = false; root.canceled(); } }
    visible: root.open;
    background: Palette.smoke;
    TouchArea { clicked => { if root.dismiss-on-outside { root.dismiss(); } } }
    forward-focus: scope;
    scope := FocusScope {
        enabled: root.open;
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); return accept; }
            if event.text == Key.Tab {
                if root.focus-next-requested(event.modifiers.shift) { return accept; }
                root.focus-index = 1 - root.focus-index;
                if root.focus-index == 0 && root.primary-enabled { accept-button.focus-button(); } else { cancel-button.focus-button(); }
                return accept;
            }
            return reject;
        }
    panel := Rectangle {
        width: Math.max(0px, Math.min(460px, root.width - 32px));
        height: Math.min(Math.max(0px, root.height - 32px), layout.preferred-height);
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        background: Palette.popup-background; border-width: ForgeMetrics.stroke-width; border-color: Palette.border; border-radius: ForgeMetrics.surface-radius;
        clip: true;
        TouchArea { }
        layout := VerticalLayout {
            padding: 24px; spacing: 18px;
            Text { text: root.title; color: Palette.foreground; font-weight: 600; font-size: 22px * ForgeTypography.scale; wrap: word-wrap; }
            // 消息与自定义内容超出可用高度时在此滚动，标题和按钮始终可见。
            body-scroll := ScrollView {
                preferred-height: body.preferred-height;
                vertical-stretch: 1;
                body := VerticalLayout {
                    width: body-scroll.visible-width;
                    spacing: 18px;
                    Text { text: root.message; color: Palette.foreground; font-size: 14px * ForgeTypography.scale; wrap: word-wrap; }
                    Rectangle { @children }
                }
            }
            Rectangle { height: 1px; background: Palette.divider; }
            HorizontalLayout {
                spacing: 10px; alignment: end;
                cancel-button := ForgePillButton { text: root.cancel-text; clicked => { root.dismiss(); } }
                accept-button := ForgePillButton {
                    text: root.primary-text; primary: true; enabled: root.primary-enabled;
                    clicked => { root.open = false; root.accepted(); }
                }
            }
        }
    }
    }
    changed open => {
        if root.open {
            root.focus-index = root.primary-enabled ? 0 : 1;
            if !root.initial-focus-requested() {
                if root.primary-enabled { accept-button.focus-button(); } else { cancel-button.focus-button(); }
            }
        } else { root.focus-return-requested(); }
    }
}
