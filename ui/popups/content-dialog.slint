import { Palette } from "std-widgets.slint";
import { ForgePillButton } from "../inputs/action-buttons.slint";
import { ForgeTypography } from "../typography/typography.slint";

export component ForgeContentDialog inherits Rectangle {
    in-out property<bool> open: false;
    in property<string> title;
    in property<string> message;
    in property<string> primary-text: @tr("确定");
    in property<string> cancel-text: @tr("取消");
    in property<bool> primary-enabled: true;
    in property<bool> dismiss-on-outside: false;
    callback accepted();
    callback canceled();
    private property<int> focus-index: 0;
    public function dismiss() { if root.open { root.open = false; root.canceled(); } }
    visible: root.open;
    background: #00000080;
    TouchArea { clicked => { if root.dismiss-on-outside { root.dismiss(); } } }
    forward-focus: scope;
    scope := FocusScope {
        enabled: root.open;
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); return accept; }
            if event.text == Key.Tab {
                root.focus-index = 1 - root.focus-index;
                if root.focus-index == 0 && root.primary-enabled { accept-button.focus-button(); } else { cancel-button.focus-button(); }
                return accept;
            }
            return reject;
        }
    panel := Rectangle {
        width: Math.max(0px, Math.min(460px, root.width - 32px));
        height: Math.min(Math.max(0px, root.height - 32px), layout.preferred-height);
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        background: Palette.background; border-width: 1px; border-color: Palette.border; border-radius: 10px;
        TouchArea { }
        layout := VerticalLayout {
            padding: 24px; spacing: 18px;
            Text { text: root.title; color: Palette.foreground; font-weight: 600; font-size: 22px * ForgeTypography.scale; wrap: word-wrap; }
            Text { text: root.message; color: Palette.foreground; font-size: 13px * ForgeTypography.scale; wrap: word-wrap; }
            Rectangle { @children }
            HorizontalLayout {
                spacing: 10px; alignment: end;
                cancel-button := ForgePillButton { text: root.cancel-text; clicked => { root.dismiss(); } }
                accept-button := ForgePillButton {
                    text: root.primary-text; primary: true; enabled: root.primary-enabled;
                    clicked => { root.open = false; root.accepted(); }
                }
            }
        }
    }
    }
    changed open => {
        if root.open { root.focus-index = root.primary-enabled ? 0 : 1; if root.primary-enabled { accept-button.focus-button(); } else { cancel-button.focus-button(); } }
    }
}
