import { Button, Palette } from "std-widgets.slint";
import { ForgeTypography } from "../typography/typography.slint";

export enum ForgeDrawerEdge { left, right }
export component ForgeDrawer inherits Rectangle {
    in-out property<bool> open: false;
    in property<string> title;
    in property<length> panel-width: 360px;
    in property<ForgeDrawerEdge> edge: right;
    in property<bool> dismiss-on-outside: true;
    callback dismissed();
    public function dismiss() { if root.open { root.open = false; root.dismissed(); } }
    visible: root.open; background: #00000070;
    TouchArea { clicked => { if root.dismiss-on-outside { root.dismiss(); } } }
    forward-focus: scope;
    scope := FocusScope {
        enabled: root.open;
        key-pressed(event) => { if event.text == Key.Escape { root.dismiss(); return accept; } return reject; }
    Rectangle {
        width: Math.max(0px, Math.min(root.width, root.panel-width));
        x: root.edge == ForgeDrawerEdge.left ? 0px : root.width - self.width;
        y: 0px; height: root.height; background: Palette.background;
        TouchArea { }
        VerticalLayout {
            padding: 20px; spacing: 16px;
            HorizontalLayout {
                height: 36px; vertical-stretch: 0;
                Text { text: root.title; color: Palette.foreground; font-size: 20px * ForgeTypography.scale; font-weight: 600; wrap: word-wrap; }
                Button { text: "×"; accessible-label: @tr("关闭"); clicked => { root.dismiss(); } }
            }
            Rectangle { clip: true; @children }
        }
    }
    }
    changed open => { if root.open { scope.focus(); } }
}
